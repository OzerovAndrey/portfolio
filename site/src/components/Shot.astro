---
// Скрін із маніфесту src/content/shots.json. Файл лежить у src/assets/<file> → оптимізоване зображення (astro:assets);
// файлу немає → плейсхолдер-«креслення» тієї самої пропорції (верстка не стрибає після заміни).
// Наявність файлу перевіряється на етапі білду (import.meta.glob): заміна скріна = покласти PNG з потрібним іменем і запушити.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import shots from "../content/shots.json";
import { t, type Locale } from "../i18n";

interface Props { id: string; lang: Locale; sizes?: string; loading?: "lazy" | "eager"; class?: string }
const { id, lang, sizes = "(min-width: 1024px) 50vw, 100vw", loading = "lazy", class: cls } = Astro.props;

const shot = shots.find((s) => s.id === id);
if (!shot) throw new Error(`Shot: id "${id}" немає в src/content/shots.json`);

const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/shots/**/*.{png,jpg,jpeg,webp}", { eager: true });
const image = files[`/src/assets/${shot.file}`]?.default;
const ratio = shot.ratio.replace("/", " / ");
// повнорозмірна версія для перегляду на весь екран (клік по скріну)
// Якість: вихідники вже стиснуті (webp q92, @2x) — друге стиснення робимо м'яким (q90), а ширини доводимо до оригіналу,
// щоб на ретіні рамка 1232 px отримувала ~2464 px, а не обрізані 2000.
const QUALITY = 90;
const widths = image ? [...new Set([640, 960, 1440, 2000, 2560, image.width].filter((w) => w <= image.width))] : [];
const full = image ? await getImage({ src: image, width: image.width, format: "webp", quality: 92 }) : null;
const a11y = t(lang).a11y;
---
{image ? (
  <figure class:list={["shot", "shot--ready", cls]} data-shot={id} data-status="ready" style={`aspect-ratio: ${ratio}`}>
    <button type="button" class="shot__zoom" data-zoom={full?.src} data-zoom-close={a11y.closeZoom} aria-label={`${a11y.zoomShot}: ${shot.alt[lang]}`} data-event="shot_zoom">
      <Image src={image} alt={shot.alt[lang]} widths={widths} quality={QUALITY} sizes={sizes} loading={loading} decoding="async" class="shot__img" />
    </button>
  </figure>
) : (
  <figure class:list={["shot", "shot--placeholder", cls]} data-shot={id} data-status="placeholder" style={`aspect-ratio: ${ratio}`} role="img" aria-label={shot.alt[lang]}>
    <figcaption class="shot__caption">
      <span class="shot__label ts-label-sm">SHOT · {id} · {shot.size}</span>
      <span class="shot__what ts-body-md-regular">{shot.what[lang]}</span>
    </figcaption>
  </figure>
)}

<script>
  // Перегляд скріна на весь екран: один <dialog> на сторінку; закривається кліком, Esc або кнопкою
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("[data-zoom]");
    if (!btn?.dataset.zoom) return;
    let dlg = document.querySelector<HTMLDialogElement>("dialog.shot-dialog");
    if (!dlg) {
      dlg = document.createElement("dialog");
      dlg.className = "shot-dialog";
      dlg.innerHTML = `<img class="shot-dialog__img" alt=""><button type="button" class="shot-dialog__close" autofocus></button>`;
      dlg.addEventListener("click", () => dlg!.close());
      document.body.append(dlg);
    }
    const img = dlg.querySelector("img")!;
    img.src = btn.dataset.zoom; img.alt = btn.querySelector("img")?.alt ?? "";
    const close = dlg.querySelector<HTMLButtonElement>(".shot-dialog__close")!;
    close.textContent = "✕"; close.setAttribute("aria-label", btn.dataset.zoomClose ?? "Close");
    dlg.showModal();
  });
</script>

<style>
  /* align-self: Safari інакше бере висоту рядка сітки й рахує ширину з aspect-ratio */
  .shot { position: relative; margin: 0; width: 100%; align-self: start; overflow: hidden; border-radius: var(--shot-borderRadius); }
  .shot--ready { border: var(--shot-borderWidth) solid var(--shot-image-br); background: var(--shot-bg); }
  .shot__img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .shot__zoom { all: unset; display: block; width: 100%; height: 100%; cursor: zoom-in; }
  .shot__zoom:focus-visible { outline: var(--focus-outline-borderWidth) solid var(--focus-outline-color); outline-offset: calc(var(--focus-outline-borderWidth) * -2); }
  .shot--ready { transition: border-color var(--motion-duration-fast) var(--motion-easing-out); }
  .shot--ready:hover { border-color: var(--shot-br); }
  :global(.shot-dialog) { max-width: none; max-height: none; width: 100vw; height: 100dvh; margin: 0; padding: var(--l-padH); border: 0; background: transparent; display: none; place-items: center; cursor: zoom-out; }
  :global(.shot-dialog[open]) { display: grid; }
  :global(.shot-dialog::backdrop) { background: var(--glass-bg); backdrop-filter: var(--glass-backdropFilter); }
  :global(.shot-dialog__img) { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--shot-borderRadius); box-shadow: var(--demoFrame-float-boxShadow); }
  :global(.shot-dialog__close) { position: fixed; top: var(--space-padding-lg); right: var(--space-padding-lg); width: var(--size-control-lg); height: var(--size-control-lg); border-radius: var(--glass-borderRadius);
    background: var(--glass-bg); border: var(--glass-borderWidth) solid var(--glass-br); color: var(--glass-color-default); backdrop-filter: var(--glass-backdropFilter); cursor: pointer; font: inherit; }
  /* «Креслення»: пунктирна рамка, сітка на фоні, мітка й опис по центру */
  .shot--placeholder {
    display: grid; place-items: center; padding: var(--shot-padding);
    background-color: var(--shot-bg);
    background-image:
      linear-gradient(to right, var(--shot-grid-line) var(--shot-borderWidth), transparent var(--shot-borderWidth)),
      linear-gradient(to bottom, var(--shot-grid-line) var(--shot-borderWidth), transparent var(--shot-borderWidth));
    background-size: var(--shot-grid-size) var(--shot-grid-size);
    border: var(--shot-borderWidth) dashed var(--shot-br);
  }
  .shot__caption { display: flex; flex-direction: column; align-items: center; gap: var(--shot-gap); max-width: 100%; text-align: center; }
  .shot__label { padding: var(--shot-gap) var(--shot-padding); background: var(--shot-label-bg); color: var(--shot-label-color); border: var(--shot-borderWidth) solid var(--shot-grid-line); border-radius: var(--shot-borderRadius); overflow-wrap: anywhere; }
  .shot__what { padding-inline: var(--shot-gap); background: var(--shot-label-bg); color: var(--shot-what-color); }
</style>
