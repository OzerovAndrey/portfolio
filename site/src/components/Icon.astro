---
<svg class:list={["icon", cls]} viewBox={name === "aurum" || name === "atlas" ? "0 0 32 32" : "0 0 24 24"} width="24" height="24" fill={brandMark ? "currentColor" : "none"} stroke={brandMark ? "none" : "currentColor"} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {shapes.map(([tag, a]) => tag === "path" ? <path d={a as string} fill-rule={name === "contra" ? "evenodd" : undefined} /> : tag === "rect" ? <rect {...(a as Record<string, number>)} /> : <circle {...(a as Record<string, number>)} />)}
</svg>

<style>
  .icon { flex: none; width: var(--icon-size, var(--iconSize-md)); height: var(--icon-size, var(--iconSize-md)); }
</style>
