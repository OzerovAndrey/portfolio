---
// Та сама лінійна монохромна мова, що в ProcessFlow: невеликі контури й один суцільний акцент.
interface Props { index: number }
const { index } = Astro.props;
---
<svg class="system-art" viewBox="0 0 200 140" fill="none" aria-hidden="true" focusable="false">
  {index === 0 && <>
    <path class="surface" d="m100 72 55 27-55 27-55-27Z" />
    <path class="surface" d="m100 52 55 27-55 27-55-27Z" />
    <path class="badge" d="m100 32 55 27-55 27-55-27Z" />
    <path class="badge-mark" d="m86 58 10 5 19-10" />
  </>}
  {index === 1 && <>
    <rect class="surface" x="36" y="25" width="128" height="84" rx="9" />
    <path class="ink" d="M36 43h128" />
    <circle class="badge" cx="47" cy="34" r="2.5" /><circle class="muted-fill" cx="56" cy="34" r="2.5" />
    <rect class="soft" x="48" y="55" width="33" height="40" rx="4" />
    <path class="edge" d="M93 59h56M93 69h40" /><rect class="badge" x="93" y="82" width="37" height="13" rx="4" />
    <circle class="badge" cx="77" cy="124" r="5" /><circle class="muted-fill" cx="100" cy="124" r="5" /><circle class="surface" cx="123" cy="124" r="5" />
  </>}
  {index === 2 && <>
    <path class="surface" d="M60 18h62l22 22v77a7 7 0 0 1-7 7H60a7 7 0 0 1-7-7V25a7 7 0 0 1 7-7Z" />
    <path class="ink" d="M122 18v16a6 6 0 0 0 6 6h16M68 39h32m-22 22-10 10 10 10m39-20 10 10-10 10m-26 4 10-28" />
    <path class="edge" d="M68 99h40" />
    <circle class="badge" cx="145" cy="109" r="19" /><path class="badge-mark" d="m136 109 6 6 12-14" />
  </>}
</svg>
<style>
  .system-art { display: block; width: 100%; height: auto; padding: var(--space-padding-lg); }
  .surface { fill: var(--color-surface-raised); stroke: var(--color-content-primary); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .soft { fill: var(--color-surface-base); stroke: var(--color-content-secondary); stroke-width: 1.5; }
  .edge { stroke: var(--color-content-secondary); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .ink { stroke: var(--color-content-primary); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .muted-fill { fill: var(--color-content-secondary); }
  .badge { fill: var(--color-content-primary); }
  .badge-mark { stroke: var(--color-canvas-primary); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
</style>
