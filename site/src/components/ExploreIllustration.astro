---
// Векторні ілюстрації пояснюють зміст: шари, варіанти одного UI, пайплайн із перевірками.
interface Props { index: number }
const { index } = Astro.props;
---
<svg class="system-art" viewBox="0 0 360 240" fill="none" aria-hidden="true" focusable="false">
  <defs><pattern id={`dots-${index}`} width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".7" fill="currentColor" opacity=".14" /></pattern></defs>
  <rect width="360" height="240" fill={`url(#dots-${index})`} />
  {index === 0 && <>
    <path class="connector" d="M180 38v166M78 120h204" stroke-dasharray="3 6" />
    {[0,1,2].map((n) => <g class:list={["art-layer", `art-layer--${n}`]}>
      <path class="surface" d={`M180 ${41+n*43} 290 ${89+n*43} 180 ${137+n*43} 70 ${89+n*43}Z`} />
      <path class="edge" d={`M70 ${89+n*43}v10l110 48 110-48v-10M180 ${137+n*43}v10`} />
      <path class="ink" d={`m143 ${86+n*43} 24 10 48-21`} />
      <circle class="node" cx="180" cy={41+n*43} r="3" />
    </g>)}
    <circle class="node" cx="70" cy="89" r="4" /><circle class="node" cx="290" cy="175" r="4" />
  </>}
  {index === 1 && <>
    <path class="connector" d="M180 30v180M80 120h200" stroke-dasharray="3 6" />
    {[{x:35,y:36,r:5},{x:190,y:36,r:1},{x:35,y:132,r:16},{x:190,y:132,r:8}].map((p,i) => <g class="brand-window">
      <rect class="surface" x={p.x} y={p.y} width="135" height="80" rx={p.r} />
      <path class="edge" d={`M${p.x} ${p.y+20}h135`} />
      <circle class="brand-dot" cx={p.x+13} cy={p.y+10} r="3" style={`--art-brand: var(--art-brand-${i+1})`} />
      <rect class="soft" x={p.x+11} y={p.y+31} width="45" height="36" rx={p.r/2} />
      <path class="edge" d={`M${p.x+68} ${p.y+34}h52m-52 8h37`} />
      <rect class="brand-dot" x={p.x+68} y={p.y+54} width="43" height="13" rx={p.r/2} style={`--art-brand: var(--art-brand-${i+1})`} />
    </g>)}
    <rect class="badge" x="164" y="104" width="32" height="32" rx="9" /><path class="badge-mark" d="m174 120 4 4 8-9" />
  </>}
  {index === 2 && <>
    <path class="connector" d="M82 83h196v65H82Z" stroke-dasharray="4 5" />
    <rect class="surface" x="32" y="43" width="105" height="82" rx="8" />
    <path class="edge" d="M32 61h105" /><circle class="node" cx="44" cy="52" r="2" /><circle class="node" cx="52" cy="52" r="2" />
    <rect class="soft" x="44" y="74" width="30" height="36" rx="4" /><path class="edge" d="M84 78h38M84 87h28M84 101h32" />
    <rect class="surface" x="223" y="43" width="105" height="82" rx="8" /><path class="edge" d="M223 61h105" />
    <path class="ink" d="m247 79-9 9 9 9m56-18 9 9-9 9m-33 5 9-28" />
    <circle class="badge" cx="180" cy="83" r="22" /><path class="badge-mark" d="m170 83 7 7 13-15" />
    <rect class="surface" x="90" y="151" width="180" height="62" rx="8" />
    {[0,1,2].map(n=><g><circle class="soft" cx="109" cy={166+n*16} r="5" /><path class="ink" d={`m106 ${166+n*16} 2 2 4-4`} /><path class="edge" d={`M124 ${166+n*16}h${113-n*19}`} /></g>)}
  </>}
</svg>
<style>
  .system-art { display: block; width: 100%; height: auto; color: var(--positioning-label-color); }
  .surface { fill: var(--color-surface-raised); stroke: var(--color-content-secondary); stroke-opacity: .35; stroke-width: 1.2; }
  .soft { fill: var(--color-surface-base); stroke: var(--color-line-subtle); }
  .edge, .connector { stroke: var(--color-content-secondary); stroke-opacity: .4; stroke-linecap: round; stroke-linejoin: round; }
  .ink { stroke: var(--color-content-primary); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .node { fill: var(--color-content-secondary); }
  .badge { fill: var(--color-content-primary); stroke: var(--color-line-default); }
  .badge-mark { stroke: var(--color-canvas-primary); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .brand-dot { fill: var(--art-brand); }
</style>
