---
// Прості метафори: три шари; один інтерфейс із вибором бренду; код із перевіркою.
interface Props { index: number }
const { index } = Astro.props;
---
<svg class="system-art" viewBox="0 0 360 240" fill="none" aria-hidden="true" focusable="false">
  {index === 0 && <>
    <rect class="surface" x="100" y="55" width="160" height="52" rx="10" />
    <rect class="surface" x="85" y="94" width="190" height="52" rx="10" />
    <rect class="surface" x="70" y="133" width="220" height="52" rx="10" />
    <path class="ink" d="M127 77h106M112 116h136M97 159h166" />
  </>}
  {index === 1 && <>
    <rect class="surface" x="78" y="43" width="204" height="132" rx="12" />
    <path class="edge" d="M78 69h204" />
    <circle class="brand-dot" cx="94" cy="56" r="4" style="--art-brand: var(--art-brand-1)" />
    <rect class="soft" x="96" y="86" width="60" height="68" rx="5" />
    <path class="ink" d="M174 93h85m-85 14h63" />
    <rect class="brand-dot" x="174" y="131" width="65" height="23" rx="5" style="--art-brand: var(--art-brand-1)" />
    {[0,1,2,3].map(i=><circle class="brand-dot" cx={132+i*32} cy="200" r="8" style={`--art-brand: var(--art-brand-${i+1})`} />)}
  </>}
  {index === 2 && <>
    <rect class="surface" x="96" y="43" width="150" height="154" rx="12" />
    <path class="edge" d="M96 70h150" />
    <path class="ink" d="m145 103-18 17 18 17m53-34 18 17-18 17m-36 7 15-48" />
    <circle class="badge" cx="244" cy="173" r="31" />
    <path class="badge-mark" d="m231 173 9 9 17-20" />
  </>}
</svg>
<style>
  .system-art { display: block; width: 100%; height: auto; color: var(--positioning-label-color); }
  .surface { fill: var(--color-surface-raised); stroke: var(--color-content-secondary); stroke-opacity: .35; stroke-width: 1.2; }
  .soft { fill: var(--color-surface-base); stroke: var(--color-line-subtle); }
  .edge, .connector { stroke: var(--color-content-secondary); stroke-opacity: .4; stroke-linecap: round; stroke-linejoin: round; }
  .ink { stroke: var(--color-content-primary); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .node { fill: var(--color-content-secondary); }
  .badge { fill: var(--color-content-primary); stroke: var(--color-line-default); }
  .badge-mark { stroke: var(--color-canvas-primary); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .brand-dot { fill: var(--art-brand); }
</style>
