---
import ThemeToggle from "./ThemeToggle.tsx";
import Logo from "./Logo.astro";
import type { Page } from "../layouts/Base.astro";
import { href, locales, swapLang, t, type Locale } from "../i18n";

interface Props { lang: Locale; page: Page }
const { lang, page } = Astro.props;
const d = t(lang);
const nav = [
  { id: "cases", label: d.nav.cases, url: href(lang, "cases") },
  { id: "approach", label: d.nav.approach, url: href(lang, "approach") },
  { id: "services", label: d.nav.services, url: href(lang, "services") },
  { id: "about", label: d.nav.about, url: href(lang, "about") },
  { id: "contact", label: d.nav.contact, url: href(lang, "contact") },
] as const;
const path = Astro.url.pathname;
---
<header class="header surface surface--glass-whisper" data-header>
  <div class="container header__inner">
    <a class="header__logo" href={href(lang)} aria-label={d.a11y.home}>
      <Logo variant="full" class="logo-full" />
      <Logo variant="symbol" class="logo-short" />
      <span class="header__owner ts-label-md" aria-hidden="true">{d.brand.owner}</span>
    </a>
    <nav class="nav" id="site-nav" aria-label={d.a11y.nav}>
      {nav.map((n) => (
        <a class="nav__item ts-label-md" href={n.url} aria-current={n.id === page ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="header__tools">
      <div class="lang" role="group" aria-label={d.a11y.lang}>
        {locales.map((l) => (
          <a class="lang__item ts-label-sm" href={swapLang(path, l)} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined} data-event={l === lang ? undefined : `lang_${l}`}>{l.toUpperCase()}</a>
        ))}
      </div>
      <ThemeToggle client:idle labelToDark={d.a11y.themeToDark} labelToLight={d.a11y.themeToLight} />
      <!-- < 900 px: навігація ховається за кнопкою. Кнопку показує скрипт; без JS навігація лишається рядком із прокруткою -->
      <button type="button" class="menu-toggle ts-label-md" aria-controls="site-nav" aria-expanded="false" data-menu-toggle hidden>
        <span class="menu-toggle__icon" aria-hidden="true"></span><span class="menu-toggle__label">{d.a11y.menu}</span>
      </button>
    </div>
  </div>
</header>
<!-- до першого кадру: згорнути меню, інакше шапка стрибає, коли спрацює модульний скрипт (CLS) -->
<script is:inline>
  (function () { var h = document.querySelector("[data-header]"), b = h && h.querySelector("[data-menu-toggle]"); if (b) { h.dataset.menu = "closed"; b.hidden = false; } })();
</script>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const btn = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  if (header && btn) {
    const set = (open: boolean) => { header.dataset.menu = open ? "open" : "closed"; btn.setAttribute("aria-expanded", String(open)); };
    set(false);
    btn.hidden = false;
    btn.addEventListener("click", () => set(header.dataset.menu !== "open"));
    header.addEventListener("keydown", (e) => { if (e.key === "Escape" && header.dataset.menu === "open") { set(false); btn.focus(); } });
    header.querySelectorAll(".nav__item").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("click", (e) => { if (header.dataset.menu === "open" && !header.contains(e.target as Node)) set(false); });
    // повернення на широкий екран — меню знову звичайне
    matchMedia("(min-width: 900px)").addEventListener("change", (m) => { if (m.matches) set(false); });
  }
</script>

<style>
  /* Редакційна шапка: типографіка на смузі, а не контроли в капсулі. Матеріал — примітив .surface--glass-whisper (visual.css: blur 12 px, fallback, reduced transparency),
     але з локальним заповненням siteHeader.bg (напівпрозоре полотно α88): шапка накладається на демо й скріни, і whisper / default там не дають читабельності
     (текст на білій демо-панелі під dark whisper ≈ 1.2 : 1). На всю ширину: без радіуса й тіні, знизу тільки hairline. Загальна висота та сама, що була (siteHeader.height): контент нижче не зсувається.
     Без backdrop-filter і з prefers-reduced-transparency — суцільна заливка (glass.whisper.solid) із рамкою */
  .header {
    --surface-glass: var(--siteHeader-bg); --surface-fill: var(--siteHeader-bgSolid); --surface-br: var(--siteHeader-br);
    position: sticky; top: 0; z-index: 5; border-width: 0 0 var(--siteHeader-borderWidth); border-radius: 0; box-shadow: none;
  }
  .header__inner { display: flex; align-items: center; gap: var(--siteHeader-gap); height: calc(var(--siteHeader-height) - var(--siteHeader-borderWidth)); }
  /* Лого AO Studio + ім'я власника через hairline-роздільник. Висота знака — siteHeader.logo.size, ширина з пропорцій SVG */
  .header__logo { --logo-size: var(--siteHeader-logo-size); display: inline-flex; align-items: center; gap: var(--space-gap-md); color: var(--siteHeader-logo-color); text-decoration: none; white-space: nowrap; }
  .header__owner { display: inline-flex; align-items: center; gap: var(--space-gap-md); color: var(--siteHeader-owner-color); transition: color var(--motion-duration-fast) var(--motion-easing-out); }
  .header__owner::before { content: ""; height: 1em; border-inline-start: var(--siteHeader-borderWidth) solid var(--siteHeader-br); }
  .header__logo:hover .header__owner { color: var(--siteHeader-logo-color); }
  .nav { display: flex; gap: var(--siteNav-gap); margin-inline-start: auto; }
  .nav__item {
    position: relative; display: inline-flex; align-items: center;
    height: var(--siteNav-item-size); padding-inline: var(--siteNav-item-paddingH);
    color: var(--siteNav-item-color-default); text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-easing-out);
  }
  .nav__item:hover { color: var(--siteNav-item-color-hover); }
  /* Активний пункт: колір + тонка лінія 1 px (без анімації) */
  .nav__item[aria-current="page"] { color: var(--siteNav-item-color-active); }
  /* Індикатор: та сама лінія для hover і активного пункту — на hover виростає зліва (scaleX), активний — повна */
  .nav__item::after {
    content: ""; position: absolute; inset-inline: var(--siteNav-item-paddingH); bottom: var(--space-gap-md);
    height: var(--siteNav-item-indicator-height); background: var(--siteNav-item-indicator-bg);
    transform: scaleX(0); transform-origin: left center; transition: transform var(--motion-duration-base) var(--motion-easing-out);
  }
  .nav__item[aria-current="page"]::after { transform: scaleX(1); }
  @media (hover: hover) { .nav__item:hover::after { transform: scaleX(1); } }
  .nav__item:focus-visible::after { transform: scaleX(1); }
  .header__tools { display: flex; align-items: center; gap: var(--siteHeader-gap); }
  /* EN / UK: два текстові посилання з тонким роздільником замість сегмент-контролу */
  .lang { display: inline-flex; align-items: center; }
  .lang__item {
    position: relative; display: inline-flex; align-items: center; height: var(--langSwitch-size); padding-inline: var(--langSwitch-item-paddingH);
    color: var(--langSwitch-item-color-default); text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-easing-out);
  }
  .lang__item + .lang__item::before { content: ""; position: absolute; inset-inline-start: 0; top: 50%; height: 1em; transform: translateY(-50%); border-inline-start: var(--siteHeader-borderWidth) solid var(--siteHeader-br); }
  .lang__item:hover { color: var(--langSwitch-item-color-hover); }
  .lang__item[aria-current="true"] { color: var(--langSwitch-item-color-active); }
  .lang__item[aria-current="true"]::after {
    content: ""; position: absolute; inset-inline: var(--langSwitch-item-paddingH); bottom: var(--space-gap-sm);
    height: var(--siteNav-item-indicator-height); background: var(--siteNav-item-indicator-bg);
  }
  /* Тема: іконка без фону, відгук — тонкий тон, як у text-кнопки */
  :global(.theme-toggle) {
    display: inline-grid; place-items: center; width: var(--langSwitch-size); height: var(--langSwitch-size);
    border: 0; border-radius: var(--button-borderRadius); background: transparent; color: var(--siteHeader-logo-color); cursor: pointer;
    transition: background-color var(--motion-duration-fast) var(--motion-easing-out);
  }
  :global(.theme-toggle:hover) { background: var(--action-text-bg-hover); }
  :global(.theme-toggle:active) { background: var(--action-text-bg-active); }
  .header__logo :global(.logo-short) { display: none; }
  .menu-toggle { display: none; }
  /* Дотик: цілі не менші за 48 px */
  @media (pointer: coarse) {
    .nav__item { height: var(--size-control-lg); }
    .lang__item { height: var(--size-control-lg); }
    :global(.theme-toggle) { width: var(--size-control-lg); height: var(--size-control-lg); }
  }
  /* Вузькі екрани: п'ять пунктів не вміщаються в один рядок — меню другим рядком, з прокруткою */
  @media (max-width: 899px) {
    .header__inner { height: auto; flex-wrap: wrap; row-gap: 0; padding-block: var(--space-gap-sm) 0; }
    .header__tools { margin-inline-start: auto; }
    .nav { order: 3; flex-basis: 100%; margin-inline-start: 0; gap: 0; overflow-x: auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .nav__item { flex: none; padding-inline: var(--space-gap-md); }
    .nav { margin-inline: calc(var(--space-gap-md) * -1); flex-basis: calc(100% + var(--space-gap-md) * 2); }
  }
  /* Кнопка «Menu» (є JS): навігація згорнута; відкрита — панель-оверлей під рядком шапки */
  @media (max-width: 899px) {
    .menu-toggle:not([hidden]) {
      display: inline-flex; align-items: center; gap: var(--space-gap-md); height: var(--langSwitch-size); padding-inline: var(--space-gap-md);
      border: var(--siteHeader-borderWidth) solid var(--siteHeader-br); border-radius: var(--button-borderRadius); background: transparent; color: var(--siteHeader-logo-color); cursor: pointer;
    }
    /* гамбургер: середня лінія — сам елемент, верхня / нижня — ::before / ::after; відкрито — середня зникає, крайні сходяться в × */
    .menu-toggle__icon { position: relative; width: var(--iconSize-sm); height: var(--borderWidth-control); background: currentColor; transition: background-color var(--motion-duration-fast) var(--motion-easing-out); }
    .menu-toggle__icon::before, .menu-toggle__icon::after { content: ""; position: absolute; inset-inline: 0; height: 100%; background: currentColor; transition: transform var(--motion-duration-base) var(--motion-easing-standard); }
    .menu-toggle__icon::before { transform: translateY(calc(var(--borderWidth-control) * -4)); }
    .menu-toggle__icon::after { transform: translateY(calc(var(--borderWidth-control) * 4)); }
    [data-menu="open"] .menu-toggle__icon { background-color: transparent; }
    [data-menu="open"] .menu-toggle__icon::before { transform: rotate(45deg); }
    [data-menu="open"] .menu-toggle__icon::after { transform: rotate(-45deg); }
    [data-menu] .header__inner { padding-block: var(--space-gap-sm); }
    /* Відкрите меню — панель поверх сторінки під рядком шапки (absolute від sticky .header): висота документа не змінюється, Hero не зсувається.
       Суцільна заливка шапки й hairline знизу; коротка поява opacity + зсув на motion-токенах */
    [data-menu] .nav {
      position: absolute; inset-inline: 0; top: 100%; margin: 0; flex-basis: auto;
      flex-direction: column; overflow: visible; padding: var(--space-gap-md) var(--l-padH);
      background: var(--siteHeader-bgSolid); border-bottom: var(--siteHeader-borderWidth) solid var(--siteHeader-br);
      transition: opacity var(--motion-duration-fast) var(--motion-easing-out), transform var(--motion-duration-fast) var(--motion-easing-out), visibility var(--motion-duration-fast) step-end;
    }
    [data-menu="closed"] .nav { opacity: 0; transform: translateY(calc(var(--space-gap-sm) * -1)); visibility: hidden; pointer-events: none; }
    [data-menu="open"] .nav { opacity: 1; transform: none; visibility: visible; transition-timing-function: var(--motion-easing-out), var(--motion-easing-out), step-start; }
    [data-menu] .nav__item { height: var(--size-control-lg); padding-inline: 0; }
    [data-menu] .nav__item[aria-current="page"]::after { inset-inline: 0 auto; width: var(--iconSize-md); bottom: var(--space-gap-sm); }
  }
  @media (prefers-reduced-motion: reduce) { [data-menu] .nav { transition: none; } }
  /* < 400 px: кнопка — тільки іконка (назва лишається для скрінрідера), щоб ім'я, мова й тема вміщалися в рядок */
  @media (max-width: 399px) {
    .menu-toggle__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } /* allow: sr-only */
    .menu-toggle:not([hidden]) { width: var(--langSwitch-size); justify-content: center; padding-inline: 0; }
    .header__tools { gap: var(--space-gap-sm); }
  }
  @media (max-width: 399px) and (pointer: coarse) { .menu-toggle:not([hidden]) { width: var(--size-control-lg); } }
  @media (max-width: 899px) and (pointer: coarse) { .menu-toggle:not([hidden]) { height: var(--size-control-lg); } }
  /* Ім'я власника — поки рядок вміщає навігацію або кнопку меню поруч; далі лишається повне лого */
  @media (min-width: 900px) and (max-width: 1099px) { .header__owner { display: none; } }
  @media (max-width: 599px) { .header__owner { display: none; } }
  /* Найвужчі екрани: тільки символ AO */
  @media (max-width: 359px) {
    .header__logo :global(.logo-full) { display: none; }
    .header__logo :global(.logo-short) { display: block; }
    .header__tools { gap: var(--space-gap-sm); }
  }
</style>
