---
import ArtMotion from "./ArtMotion.astro";
import { t, type Locale } from "../i18n";
import ExploreIllustration from "./ExploreIllustration.astro";
interface Props { lang: Locale }
const { lang } = Astro.props;
const e = t(lang).explore;
---
<section class="section explore-section" id="explore" aria-labelledby="explore-heading">
  <div class="container">
    <h2 class="sr-only" id="explore-heading">{e.heading}</h2>
    <div class="explore-grid">
      {e.items.map((item,i)=>(
        <article class="explore-card" data-art-motion="illustration" aria-labelledby={`explore-title-${i}`} data-reveal>
          <div class="explore-card__visual">
            <ExploreIllustration index={i} />
          </div>
          <div class="explore-card__copy">
            <h3 class="explore-card__title ts-title-t2" id={`explore-title-${i}`}>{item.title}</h3>
            <p class="explore-card__detail ts-body-lg-regular lead">{item.detail}</p>
          {i === 0 && <ol class="explore-card__chain ts-label-sm" aria-label={e.chainLabel}>{e.chain.map(layer=><li>{layer}</li>)}</ol>}
          {i === 1 && <ul class="explore-card__chain ts-label-sm" aria-label={item.title}>{e.brandPrinciples.map(label=><li>{label}</li>)}</ul>}
          {i === 2 && <ul class="explore-card__chain ts-label-sm" aria-label={item.title}>{e.productionChain.map(label=><li>{label}</li>)}</ul>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<ArtMotion />
<style>
  .explore-grid { display: grid; gap: var(--space-padding-xl); }
  .explore-card { display: grid; grid-template-columns: calc(var(--iconSize-xl) * 8) minmax(0, 1fr); align-items: center; gap: var(--l-gap); padding-block: var(--space-padding-xl); border-top: var(--borderWidth-control) solid var(--color-line-subtle); }
  .explore-card:last-child { border-bottom: var(--borderWidth-control) solid var(--color-line-subtle); }
  .explore-card__visual { position: relative; align-self: center; justify-self: center; width: calc(var(--iconSize-xl) * 5); height: calc(var(--iconSize-xl) * 4); }
  .explore-card__copy { display: grid; gap: var(--section-text-heading); padding-inline: 0; min-width: 0; }
  .explore-card__title { color: var(--positioning-title-color); text-wrap: balance; }
  .explore-card__detail { color: var(--positioning-item-detail-color); }
  .explore-card__chain { display: flex; flex-wrap: wrap; gap: var(--space-gap-sm); padding: 0; margin: 0; list-style: none; color: var(--positioning-label-color); }
  .explore-card__chain li { display: inline-flex; align-items: center; gap: var(--space-gap-sm); padding: var(--space-gap-sm) var(--space-gap-md); border: var(--borderWidth-control) solid var(--color-line-subtle); border-radius: var(--borderRadius-control); }
  @media (max-width: 699px) { .explore-card { grid-template-columns: minmax(0, 1fr); } .explore-card__copy { padding-inline: 0; } .explore-card__visual { justify-self: start; max-width: 100%; } }
</style>
