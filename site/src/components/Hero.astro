---
// Hero: живий DRIVE. Власні перемикачі бренду й теми зберігають стан демо.
import aurumCover from "../assets/cases/aurum-dark.webp";
import driveCover from "../assets/shots/drive/dark.png";
import atlasCover from "../assets/shots/atlas/light.png";
import Button from "./Button.astro";
import { config } from "../config";
import { t, type Locale } from "../i18n";

interface Props { lang: Locale }
const { lang } = Astro.props;
const h = t(lang).hero;
const live = new URL(config.driveUrl);
const projects = [
  { name: "Aurum", url: config.demoUrl, image: aurumCover },
  { name: "DRIVE", url: config.driveUrl, image: driveCover },
  { name: "Atlas", url: config.atlasUrl, image: atlasCover },
];
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__role ts-overline-md">{h.role}</p>
      <div class="hero__headline">
      <h1 class="hero__title ts-display-d1 text-shimmer" id="hero-title">
        {h.title.map((line) => <span class="hero__line">{line}</span>)}
      </h1>
      </div>
      <p class="hero__subtitle ts-body-lg-regular">{h.subtitle}</p>
      <div class="hero__actions">
        <Button size="lg" icon="arrowUpRight" href={config.driveUrl} data-live-link target="_blank" rel="noopener" aria-label={h.ctaLiveLabel} data-event="cta_live_system">{h.ctaLive}</Button>
        <Button size="lg" variant="secondary" icon="arrowDown" href="#explore" class="hero__more hero__more--desktop" data-explore data-event="cta_explore">{h.ctaHow}</Button>
      </div>
    </div>

    <div class="hero__product">
      <div class="hero__carousel" data-carousel data-switch-label={h.switchProject} role="region" aria-roledescription={h.carouselRole} aria-label={h.carouselLabel}>
        <script type="application/json" data-projects set:html={JSON.stringify(projects.map(({ name, url, image }) => ({ name, url, image: image.src })))} />
        {[{ project: projects[0], side: "previous" }, { project: projects[2], side: "next" }].map(({ project, side }) => (
          <button type="button" class={`hero__peek hero__peek--${side}`} data-project-side={side} aria-label={`${h.switchProject}: ${project.name}`}>
            <img src={project.image.src} alt="" width={project.image.width} height={project.image.height} loading="eager" />
            <span class="hero__peek-name ts-label-sm">{project.name}</span>
          </button>
        ))}
      <div class="hero__live" data-live-frame>
        <!-- src ставить скрипт після підгонки розміру: демо одразу стартує у правильній розкладці, без перебудови мобільна → десктоп -->
        <iframe class="hero__iframe" data-src={live.href} title={h.liveTitle} referrerpolicy="strict-origin-when-cross-origin" data-live-iframe></iframe>
        <span class="hero__demo-hint ts-label-sm" data-demo-hint>{h.demoHint}</span>
        <span class="hero__demo-ring" data-demo-ring hidden aria-hidden="true"></span>
        <noscript><iframe class="hero__iframe" src={live.href} title={h.liveTitle}></iframe></noscript>
      </div>
      </div>
      <div class="hero__project-choices" role="group" aria-label={h.carouselLabel}>
        {projects.map((project, index) => <button type="button" class="hero__project-choice ts-label-sm" data-project-choice={index} aria-pressed={index === 1}>{project.name}</button>)}
      </div>
      <!-- мобільні: другорядна дія — після живої системи -->
      <Button size="lg" variant="secondary" icon="arrowDown" href="#explore" class="hero__more hero__more--mobile" data-explore data-event="cta_explore">{h.ctaHow}</Button>
    </div>
  </div>
</section>

<script>
  type Theme = "light" | "dark";
  const html = document.documentElement;
  const siteTheme = (): Theme => (html.dataset.theme === "dark" ? "dark" : "light");
  /** <html> демо в iframe — той самий origin (GitHub Pages); локально (інший порт) — null */
  const demoRoot = (f: HTMLIFrameElement | null) => { try { return f?.contentDocument?.documentElement ?? null; } catch { return null; } };
  // DRIVE має власний React-перемикач теми. На тому самому origin синхронізуємо
  // через нього, щоб DOM, стан React і контрол залишались узгодженими.
  function syncTheme(iframe: HTMLIFrameElement) {
    let pinned = false;
    let expected: Theme = siteTheme();
    let watching: MutationObserver | null = null;
    const follow = () => {
      if (pinned) return;
      if (html.dataset.themeTransition !== undefined) {
        window.addEventListener("themetransitionend", follow, { once: true });
        return;
      }
      const r = demoRoot(iframe);
      const sw = r?.querySelector<HTMLButtonElement>('button.theme-toggle');
      if (!r || !sw) return;
      expected = siteTheme();
      if (r.dataset.theme !== expected) sw.click();
    };
    iframe.addEventListener("load", () => {
      watching?.disconnect();
      const r = demoRoot(iframe);
      if (!r) return;
      follow();
      watching = new MutationObserver(() => {
        const now = r.dataset.theme;
        if (now && now !== expected) pinned = true;
      });
      watching.observe(r, { attributes: true, attributeFilter: ["data-theme"] });
    });
    new MutationObserver(follow).observe(html, { attributes: true, attributeFilter: ["data-theme"] });
  }

  /** One gentle scroll demonstration, only while the frame is visible and untouched. */
  function introduceDemo(frame: HTMLElement, iframe: HTMLIFrameElement) {
    const hint = frame.querySelector<HTMLElement>("[data-demo-hint]");
    const ring = frame.querySelector<HTMLElement>("[data-demo-ring]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let used = false;
    iframe.addEventListener("load", async () => {
      if (used) return;
      used = true;
      const doc = demoRoot(iframe)?.ownerDocument;
      const win = doc?.defaultView;
      if (!doc || !win || !hint || !ring) return;
      let cancelled = false, raf = 0, timer = 0, finish = 0;
      let observer: IntersectionObserver;
      const events = ["pointerdown", "wheel", "touchstart", "keydown"] as const;
      const stop = () => {
        cancelled = true;
        cancelAnimationFrame(raf);
        clearTimeout(timer);
        clearTimeout(finish);
        observer?.disconnect();
        frame.removeAttribute("data-demo-intro");
        for (const event of events) {
          doc.removeEventListener(event, stop, true);
          frame.removeEventListener(event, stop, true);
        }
        document.removeEventListener("visibilitychange", visibility);
        reduced.removeEventListener("change", stop);
      };
      const visibility = () => { if (document.hidden) stop(); };
      for (const event of events) {
        doc.addEventListener(event, stop, { capture: true, passive: true });
        frame.addEventListener(event, stop, { capture: true, passive: true });
      }
      document.addEventListener("visibilitychange", visibility);
      reduced.addEventListener("change", stop);
      const start = () => {
        if (cancelled || document.hidden) return;
        frame.dataset.demoIntro = "active";
        const dock = doc.querySelector<HTMLElement>('[aria-label="DRIVE appearance controls"]');
        const placeRing = () => {
          if (!dock || !ring) return;
          const r = dock.getBoundingClientRect();
          const scale = iframe.getBoundingClientRect().width / iframe.offsetWidth;
          ring.style.left = `${r.left * scale}px`;
          ring.style.top = `${r.top * scale}px`;
          ring.style.width = `${r.width * scale}px`;
          ring.style.height = `${r.height * scale}px`;
          ring.hidden = false;
        };
        placeRing();
        if (!reduced.matches) {
          const scroller = doc.scrollingElement;
          const from = win.scrollY;
          const distance = Math.min(140, iframe.clientHeight * 0.16, (scroller?.scrollHeight ?? 0) - win.innerHeight - from);
          const began = performance.now();
          const tick = (now: number) => {
            if (cancelled) return;
            const progress = Math.min(1, (now - began) / 2200);
            // Cosine takes the page down and back, with zero velocity at both ends.
            const offset = distance > 0 ? distance * (1 - Math.cos(progress * Math.PI * 2)) / 2 : 0;
            win.scrollTo({ top: from + offset, behavior: "instant" });
            placeRing();
            if (progress < 1) raf = requestAnimationFrame(tick);
          };
          raf = requestAnimationFrame(tick);
        }
        finish = window.setTimeout(stop, 4500);
      };
      observer = new IntersectionObserver((entries) => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        observer.disconnect();
        timer = window.setTimeout(start, 800);
      }, { threshold: 0.55 });
      await doc.fonts.ready;
      if (!cancelled) observer.observe(frame);
    }, { once: true });
  }

  const root = document.querySelector<HTMLElement>("[data-hero]");
  if (root) {
    // Жива система: рамка задає розмір (aspect-ratio), iframe підганяється. Рамка ≥ 448 — десктоп-розкладка демо (від 768) на віртуальній
    // ширині 960 (рамка ≥ 600) або 800 (вужча, напр. 1024 у дві колонки) і масштаб = ширина рамки / віртуальна; вужча за 448 —
    // рідна мобільна розкладка демо 1:1. Без JS iframe просто заповнює рамку
    const frame = root.querySelector<HTMLElement>("[data-live-frame]");
    const iframe = root.querySelector<HTMLIFrameElement>("[data-live-iframe]");
    if (frame && iframe) {
      const MIN_SCALED = 448;
      const fit = () => {
        const w = frame.clientWidth, hgt = frame.clientHeight;
        if (!w || !hgt) return;
        const virtual = w >= 540 ? 960 : 800;
        const k = w >= MIN_SCALED ? Math.min(1, w / virtual) : 1;
        iframe.style.width = `${w / k}px`;
        iframe.style.height = `${hgt / k}px`;
        iframe.style.transform = k === 1 ? "" : `scale(${k})`;
      };
      new ResizeObserver(fit).observe(frame);
      fit();
      introduceDemo(frame, iframe);
      if (iframe.dataset.src) {
        const src = new URL(iframe.dataset.src);
        iframe.src = src.href;
      }
      syncTheme(iframe);
      const carousel = root.querySelector<HTMLElement>("[data-carousel]");
      const projects = JSON.parse(carousel?.querySelector("[data-projects]")?.textContent ?? "[]") as { name: string; url: string; image: string }[];
      const choices = [...root.querySelectorAll<HTMLButtonElement>("[data-project-choice]")];
      const liveLink = root.querySelector<HTMLAnchorElement>("[data-live-link]");
      let selected = 1, moving = false, revision = 0;
      const wrap = (i: number) => (i + projects.length) % projects.length;
      const paint = () => {
        choices.forEach((button, index) => button.setAttribute("aria-pressed", String(index === selected)));
        for (const side of ["previous", "next"] as const) {
          const button = carousel?.querySelector<HTMLButtonElement>(`[data-project-side="${side}"]`);
          const project = projects[wrap(selected + (side === "previous" ? -1 : 1))];
          if (!button || !project) continue;
          const image = button.querySelector("img")!;
          image.src = project.image;
          button.querySelector("span")!.textContent = project.name;
          button.setAttribute("aria-label", `${carousel?.dataset.switchLabel}: ${project.name}`);
        }
      };
      const select = async (index: number, direction: number) => {
        if (!carousel || moving || index === selected || !projects[index]) return;
        moving = true;
        const turn = ++revision;
        const project = projects[index];
        const side = carousel.querySelector<HTMLElement>(`[data-project-side="${direction < 0 ? "previous" : "next"}"]`)!;
        const from = side.getBoundingClientRect(), to = frame.getBoundingClientRect();
        const card = document.createElement("img");
        card.className = "hero__transition-card";
        card.src = project.image;
        card.alt = "";
        carousel.append(card);
        // Cancel the initial scroll hint before navigating the live document.
        frame.dispatchEvent(new Event("pointerdown"));
        frame.removeAttribute("data-demo-intro");
        const ready = new Promise<void>(resolve => iframe.addEventListener("load", () => resolve(), { once: true }));
        selected = index;
        iframe.title = project.name;
        iframe.src = project.url;
        if (liveLink) { liveLink.href = project.url; liveLink.setAttribute("aria-label", `${project.name} ↗`); }
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) {
          await card.animate([
            { transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height}) rotate(${direction < 0 ? -4 : 4}deg)` },
            { transform: "none" },
          ], { duration: 520, easing: "cubic-bezier(.22,.68,0,1)", fill: "both" }).finished;
        }
        paint();
        moving = false;
        // A screenshot covers the loading frame, then yields to the actual interactive page.
        await Promise.race([ready, new Promise(resolve => setTimeout(resolve, 12000))]);
        if (turn === revision && !reduced) await card.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 180, fill: "forwards" }).finished;
        card.remove();
      };
      carousel?.querySelectorAll<HTMLButtonElement>("[data-project-side]").forEach(button => {
        button.addEventListener("click", () => {
          const direction = button.dataset.projectSide === "previous" ? -1 : 1;
          void select(wrap(selected + direction), direction);
        });
      });
      choices.forEach((button, index) => {
        button.addEventListener("click", () => void select(index, index === wrap(selected - 1) ? -1 : 1));
        button.addEventListener("keydown", event => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          const direction = event.key === "ArrowLeft" ? -1 : 1;
          const next = wrap(selected + direction);
          choices[next].focus();
          void select(next, direction);
        });
      });
      const swipe = (target: EventTarget) => {
        let point: { x: number; y: number } | null = null;
        target.addEventListener("touchstart", ((event: TouchEvent) => {
          if ((event.target as Element).closest?.("a, button, input, select, textarea")) { point = null; return; }
          const touch = event.touches[0];
          point = touch ? { x: touch.clientX, y: touch.clientY } : null;
        }) as EventListener, { passive: true });
        target.addEventListener("touchend", ((event: TouchEvent) => {
          const touch = event.changedTouches[0];
          if (!point || !touch) return;
          const dx = touch.clientX - point.x, dy = touch.clientY - point.y;
          point = null;
          if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
          const direction = dx < 0 ? 1 : -1;
          void select(wrap(selected + direction), direction);
        }) as EventListener, { passive: true });
      };
      if (carousel) swipe(carousel);
      iframe.addEventListener("load", () => {
        const doc = demoRoot(iframe)?.ownerDocument;
        if (doc) swipe(doc);
      });
      paint();

    }
    // «Повітря»: рамка трохи обганяє сторінку при скролі (паралакс до −drift). p — шлях рамки крізь в'юпорт (0 — входить знизу,
    // 1 — виходить угорі); y = −(p − p0) / (1 − p0) відносно стартового p0 → у спокої рамка на місці (відступ від хедера
    // не з'їдається), при скролі вниз плавно йде вгору. CSS множить y на токен drift. Тільки transform, один кадр на rAF
    if (frame && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let raf = 0;
      // позиція рамки в документі без поточного зсуву: p0 — її шлях при scrollY = 0
      const path = (top: number, h: number, vh: number) => Math.min(1, Math.max(0, (vh - top) / (vh + h)));
      let p0 = 0;
      const measure = () => { const r = frame.getBoundingClientRect(); p0 = path(r.top + scrollY - frameShift(), r.height, innerHeight); };
      const frameShift = () => new DOMMatrixReadOnly(getComputedStyle(frame).transform).m42;
      const drift = () => {
        raf = 0;
        const r = frame.getBoundingClientRect(), vh = innerHeight;
        if (r.bottom < 0 || r.top > vh) return;
        const p = path(r.top - frameShift(), r.height, vh);
        const y = p0 >= 1 ? 0 : -Math.max(0, p - p0) / (1 - p0);
        frame.style.setProperty("--float-y", y.toFixed(4));
      };
      const queue = () => { if (!raf) raf = requestAnimationFrame(drift); };
      addEventListener("scroll", queue, { passive: true });
      addEventListener("resize", () => { measure(); queue(); });
      measure();
      drift();
    }

  }
</script>

<style>
  /* Асиметрична композиція: текст (ідентичність → твердження → CTA) і продукт ділять перший екран.
     Мобільні: та сама послідовність стовпчиком — продукт одразу після CTA, до Positioning */
  /* вертикальний ритм сторінки (--l-row: 32 → 56), а не колонковий проміжок; зверху ще + gap.md (8) — повітря між хедером і «піднятою» рамкою */
  .hero { background: var(--hero-bg); padding-block: calc(var(--l-row) + var(--space-gap-md)) var(--l-row); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--hero-gap) var(--l-gap); align-items: center; }
  .hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--hero-gap); min-width: 0; }
  .hero__role { color: var(--hero-eyebrow-color); }
  .hero__title {
    color: var(--hero-title-color); text-wrap: balance; hyphens: none; overflow-wrap: break-word;
    font-size: var(--hero-title-fontSize); line-height: var(--hero-title-lineHeight); letter-spacing: var(--hero-title-letterSpacing);
  }
  .hero__line { display: block; }
  /* Послідовна поява копі: заголовок лишається справжнім текстом, shimmer працює незалежно. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__role, .hero__headline, .hero__subtitle, .hero__actions {
      animation: hero-copy-in var(--hero-intro-duration) var(--motion-easing-out) both;
    }
    .hero__headline { animation-delay: var(--hero-intro-step); }
    .hero__subtitle { animation-delay: calc(var(--hero-intro-step) * 2); }
    .hero__actions { animation-delay: calc(var(--hero-intro-step) * 3); }
  }
  @keyframes hero-copy-in {
    from { opacity: 0; transform: translateY(var(--hero-intro-distance)); }
    to { opacity: 1; transform: none; }
  }
  .hero__subtitle { color: var(--hero-subtitle-color); font-size: var(--hero-subtitle-fontSize); line-height: var(--hero-subtitle-lineHeight); max-width: var(--layout-measure-body); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--hero-actions-gap); margin-top: var(--space-gap-md); }
  /* Вузькі екрани: CTA стовпчиком — перенос кнопок не залежить від підміни шрифту (CLS) */
  @media (max-width: 559px) { .hero__actions { flex-direction: column; align-items: stretch; align-self: stretch; } }
  .hero__carousel { position: relative; isolation: isolate; padding-inline: var(--space-padding-xl); }
  .hero__carousel .hero__live { z-index: 2; }
  .hero__peek { position: absolute; top: 0; bottom: 0; left: var(--space-padding-xl); right: var(--space-padding-xl); border: var(--demoFrame-borderWidth) solid var(--demoFrame-br); border-radius: var(--demoFrame-borderRadius); padding: 0; background: var(--demoFrame-placeholder-bg); overflow: hidden; cursor: pointer; box-shadow: var(--demoFrame-float-boxShadow); transition: transform var(--motion-duration-slow) var(--motion-easing-out); }
  .hero__peek--previous { transform: translateX(calc(var(--space-padding-xl) * -1)) scale(0.94) rotate(-4deg); }
  .hero__peek--next { transform: translateX(var(--space-padding-xl)) scale(0.94) rotate(4deg); }
  .hero__peek img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .hero__peek-name { position: absolute; bottom: var(--space-gap-md); left: var(--space-gap-md); padding: var(--space-gap-sm); border-radius: var(--glass-borderRadius); background: var(--glass-bg); color: var(--glass-color-default); }
  .hero__peek:focus-visible { outline: var(--focus-outline-borderWidth) solid var(--focus-outline-color); outline-offset: var(--focus-outline-borderWidth); }
  .hero__project-choices { display: flex; justify-content: center; gap: var(--space-gap-sm); }
  .hero__project-choice { font: inherit; cursor: pointer; padding: var(--space-gap-sm) var(--space-gap-md); border: var(--caseCard-borderWidth) solid var(--caseCard-br-default); border-radius: var(--glass-borderRadius); background: var(--caseCard-bg-default); color: var(--section-lead-color); }
  .hero__project-choice[aria-pressed="true"] { background: var(--section-title-color); color: var(--caseCard-bg-default); }
  .hero__project-choice:focus-visible { outline: var(--focus-outline-borderWidth) solid var(--focus-outline-color); outline-offset: var(--focus-outline-borderWidth); }
  .hero__carousel :global(.hero__transition-card) { position: absolute; z-index: 3; top: 0; left: var(--space-padding-xl); width: calc(100% - var(--space-padding-xl) * 2); height: 100%; object-fit: cover; object-position: top; border-radius: var(--demoFrame-borderRadius); pointer-events: none; transform-origin: top left; }
  @media (prefers-reduced-motion: reduce) { .hero__peek { transition: none; } }
  .hero__product { display: grid; gap: var(--space-gap-xl); min-width: 0; }

  /* друга дія: на десктопі поруч з основною, на мобільних — під сценою */
  .hero__product :global(.hero__more--mobile) { justify-self: center; }
  @media (max-width: 1023px) { .hero__actions :global(.hero__more--desktop) { display: none; } }
  @media (min-width: 1024px) { .hero__product :global(.hero__more--mobile) { display: none; } }
  /* Рамка живої системи: нейтральна, тонка межа, стриманий радіус, без хрому браузера й світіння. Колір дає сама система */
  .hero__live {
    position: relative; overflow: hidden; min-width: 0; aspect-ratio: 9 / 14;
    background: var(--demoFrame-placeholder-bg); border: var(--demoFrame-borderWidth) solid var(--demoFrame-br); border-radius: var(--demoFrame-borderRadius);
    /* «висить у повітрі»: багатошарова тінь + паралакс (--float-y 0…−1 ставить скрипт) + підйом при появі сторінки.
       translate (поява) і transform (скрол) — окремі властивості, тож не перебивають одна одну */
    box-shadow: var(--demoFrame-float-boxShadow);
    transform: translate3d(0, calc(var(--float-y, 0) * var(--demoFrame-float-drift)), 0);
    will-change: transform;
    animation: hero-float-in var(--demoFrame-float-duration) var(--demoFrame-float-easing) both;
  }
  @keyframes hero-float-in {
    from { translate: 0 var(--demoFrame-float-rise); opacity: 0; box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__live { transform: none; will-change: auto; animation: none; } }
  /* max-width: none — глобальне iframe { max-width: 100% } (base.css) інакше обрізає віртуальну ширину до рамки */
