---
import { t, type Locale } from "../i18n";
interface Props { lang: Locale; src: string; title: string }
const { lang, src, title } = Astro.props;
const copy = t(lang).productPreview;
---
<section class="preview" data-product-preview aria-label={copy.label}>
  <div class="toolbar" role="group" aria-label={copy.label}>
    <button class="preset ts-label-sm" data-full aria-pressed="true">{copy.full}</button>
    {[375,768,1024,1280,1440].map(width => <button class="preset ts-label-sm" data-width={width} aria-pressed="false">{width}</button>)}
    <output class="dimensions ts-label-sm" data-dimensions></output>
  </div>
  <p class="hint ts-caption-md">{copy.hint}</p>
  <div class="workspace" data-workspace>
    <div class="origin ts-caption-md" aria-hidden="true">↘</div>
    <div class="ruler ruler-x ts-caption-md" data-ruler-x aria-hidden="true"></div>
    <div class="ruler ruler-y ts-caption-md" data-ruler-y aria-hidden="true"></div>
    <div class="screen" data-screen>
      <iframe data-preview-iframe data-src={src} title={title} referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <div class="drag-cover" aria-hidden="true"></div>
    </div>
    <button class="handle handle-x" data-resize="x" aria-label={copy.width} title={copy.width}>⋮</button>
    <button class="handle handle-y" data-resize="y" aria-label={copy.height} title={copy.height}>⋯</button>
    <button class="handle handle-both" data-resize="both" aria-label={copy.both} title={copy.both}>↘</button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-preview]').forEach(root => {
    const workspace = root.querySelector<HTMLElement>('[data-workspace]')!;
    const screen = root.querySelector<HTMLElement>('[data-screen]')!;
    const iframe = root.querySelector<HTMLIFrameElement>('iframe')!;
    const output = root.querySelector<HTMLOutputElement>('output')!;
    const full = root.querySelector<HTMLButtonElement>('[data-full]')!;
    const presets = root.querySelectorAll<HTMLButtonElement>('[data-width]');
    let width = 0, height = 720, automatic = true, scale = 1;
    const gutter = () => Number.parseFloat(getComputedStyle(workspace).paddingLeft);
    const available = () => Math.max(1, root.clientWidth - gutter() * 2);
    const draw = () => {
      if (automatic) width = Math.round(available());
      scale = Math.min(1, available() / width);
      workspace.style.width = `${width * scale + gutter() * 2}px`;
      workspace.style.height = `${height * scale + gutter() * 2}px`;
      screen.style.width = `${width * scale}px`;
      screen.style.height = `${height * scale}px`;
      iframe.style.width = `${width}px`;
      iframe.style.height = `${height}px`;
      iframe.style.transform = `scale(${scale})`;
      output.textContent = `${width} × ${height} px`;
      full.setAttribute('aria-pressed', String(automatic));
      presets.forEach(button => button.setAttribute('aria-pressed', String(!automatic && Number(button.dataset.width) === width)));
      for (const axis of ['x','y']) {
        const ruler = root.querySelector<HTMLElement>(`[data-ruler-${axis}]`)!;
        const length = axis === 'x' ? width : height;
        ruler.replaceChildren();
        for (let value = 0; value <= length; value += 10) {
          const tick = document.createElement('span');
          tick.className = `tick ${value % 100 === 0 ? 'major' : ''}`;
          tick.style[axis === 'x' ? 'left' : 'top'] = `${value * scale}px`;
          if (value % 100 === 0) tick.textContent = String(value);
          ruler.append(tick);
        }
      }
    };
    full.addEventListener('click', () => { automatic = true; draw(); });
    presets.forEach(button => button.addEventListener('click', () => { automatic = false; width = Number(button.dataset.width); draw(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-resize]').forEach(handle => {
      const axis = handle.dataset.resize;
      handle.addEventListener('pointerdown', event => {
        if (event.button !== 0) return;
        event.preventDefault();
        handle.setPointerCapture(event.pointerId);
        const startX = event.clientX, startY = event.clientY, startWidth = width, startHeight = height, startScale = scale;
        root.dataset.dragging = 'true';
        automatic = false;
        const move = (next: PointerEvent) => {
          if (axis !== 'y') width = Math.round(Math.max(280, Math.min(2560, startWidth + (next.clientX - startX) / startScale)));
          if (axis !== 'x') height = Math.round(Math.max(320, Math.min(1600, startHeight + (next.clientY - startY) / startScale)));
          draw();
        };
        const stop = () => { delete root.dataset.dragging; handle.removeEventListener('pointermove', move); handle.removeEventListener('pointerup', stop); handle.removeEventListener('pointercancel', stop); };
        handle.addEventListener('pointermove', move);
        handle.addEventListener('pointerup', stop);
        handle.addEventListener('pointercancel', stop);
      });
      handle.addEventListener('keydown', event => {
        if (!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key)) return;
        event.preventDefault(); automatic = false;
        const step = event.shiftKey ? 1 : 10;
        if (axis !== 'y' && ['ArrowLeft','ArrowRight'].includes(event.key)) width = Math.max(280, Math.min(2560, width + (event.key === 'ArrowRight' ? step : -step)));
        if (axis !== 'x' && ['ArrowUp','ArrowDown'].includes(event.key)) height = Math.max(320, Math.min(1600, height + (event.key === 'ArrowDown' ? step : -step)));
        draw();
      });
    });
    new ResizeObserver(draw).observe(root);
    draw(); iframe.src = iframe.dataset.src!;
  });
</script>
<style>
  .preview { min-width: 0; width: 100%; }
  .toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-gap-sm); }
  .preset { padding: var(--space-gap-sm) var(--space-gap-md); border: var(--borderWidth-control) solid transparent; border-radius: var(--button-borderRadius); background: transparent; color: var(--positioning-label-color); cursor: pointer; }
  .preset[aria-pressed="true"] { color: var(--positioning-title-color); background: var(--caseCard-bg-default); border-color: var(--demoFrame-br); }
  .dimensions { margin-inline-start: auto; color: var(--positioning-label-color); font-variant-numeric: tabular-nums; }
  .hint { color: var(--positioning-label-color); margin-block: var(--space-gap-md); }
  .workspace { position: relative; max-width: 100%; padding: var(--space-padding-md); box-sizing: border-box; }
  .screen { position: relative; overflow: hidden; background: var(--caseCard-bg-default); outline: var(--borderWidth-control) solid var(--demoFrame-br); }
  iframe { position: absolute; inset: 0; max-width: none; border: 0; transform-origin: top left; }
  .ruler { position: absolute; overflow: hidden; color: var(--positioning-label-color); background: var(--demoFrame-placeholder-bg); font-variant-numeric: tabular-nums; }
  .ruler-x { top: 0; left: var(--space-padding-md); right: var(--space-padding-md); height: var(--space-padding-md); }
  .ruler-y { left: 0; top: var(--space-padding-md); bottom: var(--space-padding-md); width: var(--space-padding-md); }
  .origin { position: absolute; top: 0; left: 0; color: var(--positioning-label-color); }
  .ruler :global(.tick) { position: absolute; border-color: var(--demoFrame-br); border-style: solid; border-width: 0; }
  .ruler-x :global(.tick) { bottom: 0; height: 20%; border-left-width: var(--borderWidth-control); }
  .ruler-y :global(.tick) { right: 0; width: 20%; border-top-width: var(--borderWidth-control); }
  .ruler-x :global(.major) { height: 100%; padding-left: var(--space-gap-xs); }
  .ruler-y :global(.major) { width: 100%; writing-mode: vertical-rl; padding-top: var(--space-gap-xs); }
  .handle { position: absolute; border: 0; padding: 0; background: transparent; color: var(--positioning-label-color); touch-action: none; }
  .handle-x { right: 0; top: var(--space-padding-md); bottom: var(--space-padding-md); width: var(--space-padding-md); cursor: ew-resize; }
  .handle-y { bottom: 0; left: var(--space-padding-md); right: var(--space-padding-md); height: var(--space-padding-md); cursor: ns-resize; }
  .handle-both { right: 0; bottom: 0; width: var(--space-padding-md); height: var(--space-padding-md); cursor: nwse-resize; }
  .preset:focus-visible, .handle:focus-visible { outline: var(--focus-outline-borderWidth) solid var(--focus-outline-color); }
  .drag-cover { display: none; position: absolute; inset: 0; }
  [data-dragging] .drag-cover { display: block; }
  [data-dragging] { user-select: none; }
</style>
