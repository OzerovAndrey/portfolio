---
// 04 About / Expertise — коротке твердження + типографічний індекс напрямів. Коротка анімація іконок при появі та наведенні.
// Токени: ті самі editorial-токени, що в Positioning (rule / label / title / detail) — нових немає.
import Icon, { type IconName } from "./Icon.astro";
import AiToolLogo, { type AiTool } from "./AiToolLogo.astro";
import ArtMotion from "./ArtMotion.astro";
import { t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  /** Home: звичайний ритм секції (layout.rowGap) замість editorial-відступу */
  compact?: boolean;
  /** номер секції в індекс-рядку */
}
const { lang, compact = false } = Astro.props;
const e = t(lang).expertise;
// Іконки напрямів — у тому ж порядку, що й expertise.items (EN = UK)
const AI_ICON: AiTool[] = ["chatgpt", "codex", "claude-code", "figma-make", "figma-agent", "gemini"];
const ICON: IconName[] = ["pen", "layout", "component", "layers", "pointer", "code", "figma", "tokens"];
---
<section class:list={["section", "expertise", compact ? "expertise--compact" : "section--editorial"]} id="expertise" aria-labelledby="expertise-title" data-reveal>
  <div class="container">
    <p class="expertise__label ts-label-md"><span>{e.label}</span></p>
    <h2 class="expertise__statement ts-display-d2 display-lg text-shimmer" id="expertise-title">{e.statement}</h2>

    <div class="expertise__body">
      <div class="expertise__text">
        <p class="expertise__paragraph ts-body-lg-regular measure--lead lead">{e.paragraph}</p>
        <p class="expertise__closing ts-title-t5">{e.closing}</p>
      </div>
      <div class="expertise__groups">
      <div class="expertise__group">
      <h3 class="expertise__group-title ts-label-md">{e.skillsTitle}</h3>
      <ul class="expertise__list" aria-label={e.listLabel}>
        {e.items.map((item, i) => (
          <li class="expertise__item" data-art-motion="icon">
            <Icon name={ICON[i] ?? "component"} class="expertise__icon" />
            <span class="expertise__name ts-title-t4">{item}</span>
          </li>
        ))}
      </ul>
      </div>
      <div class="expertise__group">
        <h3 class="expertise__group-title ts-label-md">{e.aiTitle}</h3>
        <ul class="expertise__list" aria-label={e.aiTitle}>
          {e.aiTools.map((item, i) => (
            <li class="expertise__item" data-art-motion="icon">
              <AiToolLogo name={AI_ICON[i]} class="expertise__icon" />
              <span class="expertise__name ts-title-t4">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      </div>
    </div>
  </div>
</section>

<ArtMotion />
<style>
  .expertise__label { display: flex; align-items: baseline; gap: var(--space-gap-xl); color: var(--positioning-label-color); }
  .expertise__statement { margin-top: var(--section-gap); max-width: 24ch; color: var(--positioning-title-color); overflow-wrap: break-word; }
  .expertise__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--section-text-block); margin-top: calc(var(--section-text-heading) + var(--layout-rowGap-xs) + var(--space-padding-md) * 2); padding-bottom: var(--layout-rowGap-xs); }
  .expertise--compact .expertise__body { margin-top: calc(var(--section-text-heading) + var(--layout-rowGap-xs) + var(--space-padding-md) * 2); gap: var(--section-text-block); }
  .expertise__text { display: grid; gap: var(--space-padding-xl); align-content: start; }
  .expertise__paragraph { color: var(--positioning-item-detail-color); }
  .expertise__closing { color: var(--positioning-title-color); }
  .expertise__groups { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--section-text-block) var(--l-gap); min-width: 0; }
  .expertise__group { min-width: 0; }
  .expertise__group-title { color: var(--positioning-label-color); margin-bottom: var(--space-gap-xl); }
  @media (min-width: 768px) { .expertise__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .expertise__list { margin: 0; padding: 0; list-style: none; min-width: 0; }
  .expertise__item { display: flex; align-items: baseline; gap: var(--space-gap-xl); padding-block: var(--space-padding-sm); border-top: var(--borderWidth-control) solid var(--positioning-rule-br); min-width: 0; }
  .expertise__item:first-child { border-top: 0; }
  .expertise__item:last-child { border-bottom: var(--borderWidth-control) solid var(--positioning-rule-br); }
  .expertise__name { color: var(--positioning-title-color); overflow-wrap: anywhere; }
  .expertise__item :global(.expertise__icon) { transform-origin: center; align-self: center; --icon-size: var(--iconSize-md); color: var(--positioning-label-color); }
  .expertise__item :global(.ai-tool-logo) { color: var(--positioning-title-color); }
  /* ≥ 1200: текст ліворуч, індекс напрямів праворуч; твердження лишається найбільшим елементом */
  @media (min-width: 1200px) {
    .expertise__body { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--l-gap); align-items: center; }
    .expertise__text { grid-column: 1 / span 4; }
    .expertise__groups { grid-column: 5 / span 8; }
  }
</style>
