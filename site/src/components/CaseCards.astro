---
// Три карточки кейсів (Home і /cases). Кожна має обкладинку-кадр проєкту, щоб читатись як робота, а не інфоблок.
// Обкладинки — src/assets/cases/*-{light,dark}.webp (16:9), реальні кадри:
//   aurum — одна ілюстрація банера демо, розрізана на 4 бренди (з shots/brand-morph/lobby-*);
//   site  — головна цього сайту (hero з постером демо).
// Atlas — справжній огляд банківського демо.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { href, t, type Locale } from "../i18n";
import aurumLight from "../assets/cases/aurum-light.webp";
import aurumDark from "../assets/cases/aurum-dark.webp";
import atlasLight from "../assets/shots/atlas/light.png";
import atlasDark from "../assets/shots/atlas/dark.png";
import siteLight from "../assets/cases/site-light.webp";
import siteDark from "../assets/cases/site-dark.webp";

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const c = d.cases.items;
const sizes = "(min-width: 768px) 33vw, 100vw";
const covers = [
  { light: aurumLight, dark: aurumDark, alt: c[0].mediaAlt },
  { light: siteLight, dark: siteDark, alt: c[1].mediaAlt },
  { light: atlasLight, dark: atlasDark, alt: c[2].mediaAlt },
];
---
<ul class="cases">
  {[0, 1, 2].map((i) => (
    <li class="case">
      <div class="case__media">
        <Image src={covers[i].light} alt={covers[i].alt} widths={[480, 800, 1280, 1920].filter(w => w <= covers[i].light.width)} quality={90} sizes={sizes} loading="lazy" decoding="async" class="case__img case__img--light" />
        <Image src={covers[i].dark} alt={covers[i].alt} widths={[480, 800, 1280, 1920].filter(w => w <= covers[i].dark.width)} quality={90} sizes={sizes} loading="lazy" decoding="async" class="case__img case__img--dark" />
      </div>
      <div class="case__body">
        <span class="case__head"><Icon name={i === 1 ? "palette" : "window"} class="case__icon" /><span class="case__tag ts-label-sm">{c[i].tag}</span></span>
        <h3 class="case__title ts-title-t4">{c[i].title}</h3>
        <p class="case__detail ts-body-md-regular">{c[i].detail}</p>
        <Button variant="secondary" size="md" icon="arrowRight" class="case__cta" href={i === 0 ? href(lang, "cases/aurum-multibrand") : i === 1 ? href(lang, "approach") : href(lang, "cases/atlas-finance")} data-event={i === 0 ? "case_aurum" : i === 1 ? "case_site" : "case_atlas"}>{c[i].cta}</Button>
      </div>
    </li>
  ))}
</ul>

<style>
  .cases { display: grid; gap: var(--l-gap); }
  @media (min-width: 768px) { .cases { grid-template-columns: repeat(3, 1fr); } }
  .case { display: flex; flex-direction: column; gap: var(--caseCard-padding); padding: var(--caseCard-padding); background: var(--caseCard-bg-default); border: var(--caseCard-borderWidth) solid var(--caseCard-br-default); border-radius: var(--caseCard-borderRadius); transition: border-color var(--motion-duration-fast) var(--motion-easing-out); }
  .case:hover { background: var(--caseCard-bg-hover); border-color: var(--caseCard-br-hover); }

  /* Обкладинка-кадр проєкту */
  .case__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--caseCard-media-bg); border: var(--caseCard-borderWidth) solid var(--caseCard-media-br); border-radius: var(--caseCard-media-borderRadius); }
  .case__media :global(.case__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform var(--motion-duration-slow) var(--motion-easing-out); }
  :global(:root[data-theme="dark"]) .case__media :global(.case__img--light), :global(:root:not([data-theme="dark"])) .case__media :global(.case__img--dark) { display: none; }
  @media (hover: hover) { .case:hover .case__media :global(.case__img) { transform: scale(1.04); } }
  @media (prefers-reduced-motion: reduce) { .case__media :global(.case__img) { transform: none !important; } }

  .case__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--caseCard-gap); flex: 1; }
  .case__tag { padding-inline: var(--caseCard-tag-paddingH); height: var(--caseCard-tag-size); display: inline-flex; align-items: center; background: var(--caseCard-tag-bg); color: var(--caseCard-tag-color); border-radius: var(--caseCard-tag-borderRadius); }
  .case__head { display: flex; align-items: center; gap: var(--space-gap-md); }
  .case__head :global(.case__icon) { --icon-size: var(--iconSize-lg); color: var(--caseCard-title-color); }
  .case__title { color: var(--caseCard-title-color); }
  .case__detail { color: var(--caseCard-detail-color); }
  .case :global(.case__cta) { margin-top: auto; }
</style>
