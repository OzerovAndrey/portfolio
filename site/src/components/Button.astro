---
// Button на токенах button.* (розміри, радіус — як у демо) і action.* (кольори й стани сайту). Рендерить <a>, якщо є href.
// icon — підпис CTA: квадратний «знак» праворуч з іконкою дії (Icon.astro). Знак однаковий за геометрією в усіх CTA;
// primary — кільце з product1 чотирьох брендів демо (значення з токенів під час білду, одне місце — тут), secondary — нейтральне кільце.
// Мікрорух іконки залежить від дії: ↗ / send — по діагоналі, → / mail — вправо, ↓ — вниз, + — поворот. Іконка декоративна: дію називає підпис
import Icon, { type IconName } from "./Icon.astro";
import { BRANDS, states } from "../lib/exhibit";

interface Props {
  variant?: "primary" | "secondary" | "text";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit";
  class?: string;
  icon?: IconName;
  [attr: string]: unknown;
}
const { variant = "primary", size = "md", href, type = "button", class: cls, icon, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const MOTION: Partial<Record<IconName, string>> = { arrowUpRight: "diag", send: "diag", arrowRight: "x", mail: "x", play: "x", arrowDown: "y", plus: "turn" };
const motion = icon ? MOTION[icon] ?? "x" : undefined;
const brandAccent = BRANDS.map((b, i) => `--mb-${i + 1}: ${states[`${b}|light`].colors["color.product1"]}`).join("; ");
---
<Tag class:list={["btn", `btn--${variant}`, `btn--${size}`, size === "lg" ? "ts-label-lg" : "ts-label-md", icon && "btn--marked", cls]} href={href} type={href ? undefined : type} data-motion={motion} {...rest}>
  {icon ? <span class="btn__label"><slot /></span> : <slot />}
  {icon && (
    <span class="btn__mark" aria-hidden="true" style={variant === "primary" ? brandAccent : undefined}><Icon name={icon} class="btn__icon" /></span>
  )}
</Tag>

<style>
  /* Три ролі, одна геометрія. primary — основна дія (action.*: інверсна до теми, монохром); secondary — рамка без заливки (action.secondary.*);
     text — без рамки, той самий відгук. Рамка 1 px є в усіх варіантах (прозора в primary / text), тож розмір не залежить від варіанта.
     Скло в кнопках не використовується: воно лишається акцентом поверхонь (visual.css). Фокус — глобальний :focus-visible (base.css) */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    gap: var(--btn-gap);
    height: var(--btn-size); padding-inline: var(--btn-padH);
    border-radius: var(--button-borderRadius);
    border: var(--action-borderWidth) solid var(--btn-br, transparent);
    background: var(--btn-bg); color: var(--btn-color);
    text-decoration: none; white-space: nowrap; cursor: pointer;
    transition: background-color var(--motion-duration-base) var(--motion-easing-out), border-color var(--motion-duration-base) var(--motion-easing-out),
      color var(--motion-duration-base) var(--motion-easing-out), transform var(--motion-duration-fast) var(--motion-easing-out);
  }
  /* Дуже вузькі екрани (і zoom 200 %): підпис кнопки переноситься, а не виходить за ширину. Однорядкова кнопка лишається тієї самої висоти */
  @media (max-width: 559px) { .btn { max-width: 100%; height: auto; min-height: var(--btn-size); padding-block: var(--space-gap-sm); white-space: normal; text-align: center; } }
  .btn--sm { --btn-size: var(--button-size-sm); --btn-padH: var(--button-paddingH-sm); --btn-gap: var(--button-gap-sm); }
  .btn--md { --btn-size: var(--button-size-md); --btn-padH: var(--button-paddingH-md); --btn-gap: var(--button-gap-md); }
  .btn--lg { --btn-size: var(--button-size-lg); --btn-padH: var(--button-paddingH-xl); --btn-gap: var(--button-gap-lg); }
  /* Дотик: ціль не менша за lg (48 px) — sm / md підтягуються лише на coarse-вказівнику, на desktop розміри ті самі */
  @media (pointer: coarse) { .btn--sm, .btn--md { --btn-size: var(--button-size-lg); } }

  .btn--primary { --btn-bg: var(--action-bg-default); --btn-color: var(--action-color-default); }
  .btn--secondary { --btn-bg: var(--action-secondary-bg-default); --btn-color: var(--action-secondary-color-default); --btn-br: var(--action-secondary-br-default); }
  .btn--text { --btn-bg: var(--action-secondary-bg-default); --btn-color: var(--action-secondary-color-default); }
  /* Фокус: зовнішнє кільце 2 px із проміжком 3 px (глобальний :focus-visible дає ширину й стиль), тонший колір — кільце читається окремо від рамки кнопки */
  .btn:focus-visible { outline-color: var(--action-focus-color); outline-offset: calc(var(--focus-outline-borderWidth) * 3); }

  /* Hover — тільки там, де він є (миша): на дотику не «залипає». Відгук — тон / рамка, без руху */
  @media (hover: hover) {
    .btn:not(:disabled, [aria-disabled="true"]):hover { transform: translateY(calc(var(--motion-nudge) * -1)); }
    .btn--primary:hover { --btn-bg: var(--action-bg-hover); --btn-color: var(--action-color-hover); }
    .btn--secondary:hover { --btn-bg: var(--action-secondary-bg-hover); --btn-br: var(--action-secondary-br-hover); }
    .btn--text:hover { --btn-bg: var(--action-text-bg-hover); }
  }
  /* Натискання: тон + зсув на 1 px вниз (layout не змінюється — transform) */
  .btn--primary:active { --btn-bg: var(--action-bg-active); --btn-color: var(--action-color-active); }
  .btn--secondary:active { --btn-bg: var(--action-secondary-bg-active); --btn-br: var(--action-secondary-br-active); }
  .btn--text:active { --btn-bg: var(--action-text-bg-active); }
  .btn:active:not(:disabled, [aria-disabled="true"]) { transform: translateY(var(--action-press-distance)); }

  .btn--primary:disabled, .btn--primary[aria-disabled="true"] { --btn-bg: var(--action-bg-disabled); --btn-color: var(--action-color-disabled); }
  .btn--secondary:disabled, .btn--secondary[aria-disabled="true"] { --btn-bg: var(--action-secondary-bg-default); --btn-color: var(--action-secondary-color-disabled); --btn-br: var(--action-secondary-br-disabled); }
  .btn--text:disabled, .btn--text[aria-disabled="true"] { --btn-color: var(--action-secondary-color-disabled); }
  .btn:disabled, .btn[aria-disabled="true"] { cursor: not-allowed; }

  /* ---------- знак CTA (icon) ---------- */
  .btn--lg { --btn-mark: var(--iconSize-xl); --btn-mark-icon: var(--iconSize-md); }
  .btn--md, .btn--sm { --btn-mark: var(--iconSize-lg); --btn-mark-icon: var(--iconSize-sm); }
  /* знак сидить з рівним відступом зверху / знизу / справа */
  .btn--marked { padding-inline-end: calc((var(--btn-size) - var(--btn-mark)) / 2); }
  .btn__mark {
    display: inline-grid; place-items: center; flex: none; width: var(--btn-mark); height: var(--btn-mark); box-sizing: border-box;
    border: calc(var(--borderWidth-control) * 1.5) solid var(--btn-mark-br, transparent); border-radius: var(--borderRadius-control);
    transition: background var(--motion-duration-base) var(--motion-easing-out), border-color var(--motion-duration-base) var(--motion-easing-out);
  }
  .btn__mark :global(.btn__icon) { --icon-size: var(--btn-mark-icon); transition: transform var(--motion-duration-fast) var(--motion-easing-out); }
  /* primary: монохромна кнопка з тонким внутрішнім контуром; кільце знака — градієнт чотирьох брендів, заливка = фон кнопки */
  .btn--primary.btn--marked { box-shadow: inset 0 0 0 var(--borderWidth-control) color-mix(in srgb, var(--btn-color) 14%, transparent); }
  .btn--primary .btn__mark {
    background:
      linear-gradient(var(--btn-bg), var(--btn-bg)) padding-box,
      linear-gradient(135deg, var(--mb-1), var(--mb-2), var(--mb-3), var(--mb-4)) border-box;
  }
  /* secondary: те саме кільце, нейтральне (action.secondary.br) — без кольору брендів */
  .btn--secondary .btn__mark { --btn-mark-br: var(--action-secondary-br-default); }
  @media (hover: hover) {
    .btn--primary:hover .btn__mark {
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--mb-1) 16%, var(--btn-bg)), color-mix(in srgb, var(--mb-3) 16%, var(--btn-bg))) padding-box,
        linear-gradient(135deg, var(--mb-1), var(--mb-2), var(--mb-3), var(--mb-4)) border-box;
    }
    .btn--secondary:hover .btn__mark { --btn-mark-br: var(--action-secondary-br-hover); }
  }
  /* мікрорух іконки за типом дії — 2 px, тільки hover / клавіатурний фокус */
  .btn { --btn-nudge: var(--motion-nudge); }
  @media (hover: hover) {
    .btn[data-motion="diag"]:hover :global(.btn__icon) { transform: translate(var(--btn-nudge), calc(var(--btn-nudge) * -1)); }
    .btn[data-motion="x"]:hover :global(.btn__icon) { transform: translateX(var(--btn-nudge)); }
    .btn[data-motion="y"]:hover :global(.btn__icon) { transform: translateY(var(--btn-nudge)); }
    .btn[data-motion="turn"]:hover :global(.btn__icon) { transform: rotate(90deg); }
  }
  .btn[data-motion="diag"]:focus-visible :global(.btn__icon) { transform: translate(var(--btn-nudge), calc(var(--btn-nudge) * -1)); }
  .btn[data-motion="x"]:focus-visible :global(.btn__icon) { transform: translateX(var(--btn-nudge)); }
  .btn[data-motion="y"]:focus-visible :global(.btn__icon) { transform: translateY(var(--btn-nudge)); }
  /* натискання: кнопка зсувається на 1 px (вище), іконка повертається в спокій — коротке «клац», без масштабу */
  .btn[data-motion]:active :global(.btn__icon) { transform: none; }

  /* Reduced motion: без зсуву, кольорові переходи лишаються */
  @media (prefers-reduced-motion: reduce) {
    .btn { transition-property: background-color, border-color, color; }
    .btn:active:not(:disabled, [aria-disabled="true"]), .btn:not(:disabled, [aria-disabled="true"]):hover { transform: none; } /* та сама специфічність, що в правила натискання вище */
    .btn__mark, .btn__mark :global(.btn__icon) { transition: none; }
    .btn[data-motion] :global(.btn__icon) { transform: none !important; }
  }
</style>
