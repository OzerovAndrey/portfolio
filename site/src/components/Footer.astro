---
import Icon from "./Icon.astro";
import { config, formatPhone, links as mk } from "../config";
import Logo from "./Logo.astro";
import { href, t, type Locale } from "../i18n";
interface Props { lang: Locale }
const d = t(Astro.props.lang);
const { email, linkedin, telegram, phone, github, behance, dribbble } = config.contacts;
const groups = [
  { title: d.footer.contacts, links: mk(["Email", email && `mailto:${email}`, "mail"], ["Telegram", telegram, "send"], [formatPhone(phone), phone && `tel:${phone}`, "phone"], ["LinkedIn", linkedin, "linkedin"]) },
  { title: d.footer.design, links: mk(["Behance", behance, "image"], ["Dribbble", dribbble, "palette"]) },
  { title: d.footer.projects, links: mk([d.footer.demo, config.demoUrl, "window"], ["GitHub", github, "github"]) },
].filter(group => group.links.length);

---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href={href(Astro.props.lang)} aria-label={d.a11y.home}><Logo variant="full" /></a>
      <p class="footer__credit ts-body-sm-regular">{d.brand.credit}</p>
    </div>
    <div class="footer__groups">
      {groups.map((group, i) => (
        <section class="footer__group" aria-labelledby={`footer-group-${i}`}>
          <h2 class="footer__group-title ts-label-md" id={`footer-group-${i}`}>{group.title}</h2>
          <ul class="footer__links">
            {group.links.map(l => <li><a class="ts-title-t5" href={l.url} rel={l.url.startsWith("http") ? "noopener" : undefined}>{l.icon && <Icon name={l.icon} />}<span>{l.label}</span></a></li>)}
          </ul>
        </section>
      ))}
    </div>
    <p class="footer__meta ts-body-sm-regular">© {new Date().getFullYear()} {config.name}. {d.footer.rights}</p>
  </div>
</footer>

<style>
  /* Редакційне завершення: без заливки й карток — hairline згори, список посилань, дрібний підпис знизу. Ім'я — лише в шапці й копірайті. Фон — сторінки */
  .footer { background: var(--siteFooter-bg); border-top: var(--siteFooter-borderWidth) solid var(--siteFooter-br); color: var(--siteFooter-color); padding-block: calc(var(--siteFooter-paddingB) * 2) var(--siteFooter-paddingB); }
  .footer__inner { display: grid; gap: calc(var(--siteFooter-paddingB) * 2); grid-template-columns: minmax(0, 1fr); }
  /* Лого AO Studio і підпис власника — над посиланнями */
  .footer__brand { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-gap-lg) var(--siteFooter-gap); }
  .footer__logo { --logo-size: var(--siteFooter-logo-size); display: inline-flex; color: var(--siteFooter-logo-color); }
  .footer__credit { color: var(--siteFooter-color); }
  .footer__groups { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--section-text-block) var(--siteFooter-gap); }
  .footer__group { min-width: 0; }
  .footer__group-title { color: var(--siteFooter-color); margin-bottom: var(--space-padding-xl); }
  .footer__links { display: grid; gap: var(--space-gap-xl); align-content: start; }
  @media (min-width: 560px) { .footer__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .footer__links a { display: inline-flex; align-items: center; gap: var(--space-gap-md); color: var(--siteFooter-link-color-default); text-decoration: none; overflow-wrap: anywhere; transition: color var(--motion-duration-fast) var(--motion-easing-out); }
  .footer__links a:hover { color: var(--siteFooter-link-color-hover); }
  .footer__links a:hover span { text-decoration: underline; text-underline-offset: 0.2em; }
  .footer__links a :global(.icon) { transition: transform var(--motion-duration-fast) var(--motion-easing-out); }
  @media (hover: hover) { .footer__links a:hover :global(.icon) { transform: translateY(calc(var(--motion-nudge) * -1)); } }
  .footer__links a:focus-visible :global(.icon) { transform: translateY(calc(var(--motion-nudge) * -1)); }
  @media (prefers-reduced-motion: reduce) { .footer__links a :global(.icon) { transform: none !important; } }
  .footer__meta { padding-top: var(--siteFooter-paddingB); border-top: var(--siteFooter-borderWidth) solid var(--siteFooter-divider-color); overflow-wrap: anywhere; }
  @media (min-width: 768px) {
    .footer__groups { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
