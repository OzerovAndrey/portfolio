---
import "../styles/tokens.generated.css";
import "../styles/base.css";
import "../styles/visual.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locales, swapLang, t, type Locale } from "../i18n";
import { config, SHOW_PREVIEW_BANNER, SITE_LAUNCHED } from "../config";
// Шрифт H1 hero (Inter Tight 700) — preload, щоб він був до першого рендера: інакше на 390–412 px рядок H1
// переноситься під fallback-шрифтом і «стрибає» після підміни (CLS 0.10). Тільки Home, тільки потрібний subset мови
import interTightLatin700 from "@fontsource/inter-tight/files/inter-tight-latin-700-normal.woff2?url";
import interTightCyrillic700 from "@fontsource/inter-tight/files/inter-tight-cyrillic-700-normal.woff2?url";

export type Page = "home" | "approach" | "cases" | "services" | "about" | "contact";
interface Props { lang: Locale; title: string; description: string; page: Page }
const { lang, title, description, page } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;
const abs = (p: string) => new URL(p, Astro.site).href;
const ogImage = abs(`${import.meta.env.BASE_URL}og/${lang}.png`);
const { umamiId, umamiSrc } = config.analytics;
---
<!doctype html>
<html lang={lang} data-brand="site" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!SITE_LAUNCHED && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(path)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(swapLang(path, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(swapLang(path, "en"))} />
    <link rel="sitemap" href={abs(`${import.meta.env.BASE_URL}sitemap.xml`)} />
    {page === "home" && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org", "@type": "Person", name: config.name, url: abs(path),
        jobTitle: "Product / UI/UX Designer", brand: { "@type": "Brand", name: d.brand.name }, knowsAbout: ["Product design", "UI/UX design", "Design systems", "Multi-brand design systems", "Figma", "Tokens Studio"],
        image: abs(`${import.meta.env.BASE_URL}og/${lang}.png`),
        sameAs: [config.contacts.linkedin, config.contacts.github, config.contacts.telegram].filter(Boolean),
      })} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:site_name" content={d.meta.siteName} />
    <meta property="og:locale" content={lang === "uk" ? "uk_UA" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.homeTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    {page === "home" && <link rel="preload" as="font" type="font/woff2" crossorigin href={lang === "uk" ? interTightCyrillic700 : interTightLatin700} />}
    <!-- тема до першого рендера: вибір у межах візиту (sessionStorage) → інакше системна (prefers-color-scheme).
         Поки вибору немає, сайт іде за системою й наживо реагує на її зміну -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const mq = window.matchMedia("(prefers-color-scheme: dark)");
        const saved = () => { try { const v = sessionStorage.getItem("theme"); return v === "dark" || v === "light" ? v : null; } catch { return null; } };
        const apply = () => { root.dataset.theme = saved() ?? (mq.matches ? "dark" : "light"); };
        apply();
        root.classList.add("js");
        mq.addEventListener?.("change", () => { if (!saved()) apply(); });
      })();
    </script>
  </head>
  <body class="ts-body-md-regular">
    <a class="skip" href="#main">{d.a11y.skip}</a>
    {SHOW_PREVIEW_BANNER && (
      <div class="preview" role="status">
        <div class="container preview__inner ts-label-sm"><span class="preview__dot" aria-hidden="true"></span>{d.preview.banner}</div>
      </div>
    )}
    <Header lang={lang} page={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <!-- поява секцій: [data-reveal] → .is-visible при вході у в'юпорт (transform + opacity, див. visual.css). Без IO — одразу видимі -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) { els.forEach((el) => el.classList.add("is-visible")); return; }
        const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -10% 0px" });
        els.forEach((el) => io.observe(el));
      })();
    </script>
    {umamiId && (
      <>
        <script is:inline defer src={umamiSrc} data-website-id={umamiId}></script>
        <!-- Події: будь-який елемент з data-event="назва" → umami.track("назва"). Провайдер-агностично: у розмітці тільки data-event -->
        <script is:inline>
          document.addEventListener("click", (e) => {
            const el = e.target instanceof Element ? e.target.closest("[data-event]") : null;
            if (el && window.umami) window.umami.track(el.getAttribute("data-event"));
          }, { capture: true });
        </script>
      </>
    )}
  </body>
</html>

<style is:global>
  .preview { background: var(--banner-bg); color: var(--banner-color); border-bottom: var(--banner-borderWidth) solid var(--banner-br); padding-block: var(--banner-paddingV); }
  .preview__inner { display: flex; align-items: center; gap: var(--banner-gap); }
  .preview__dot { flex: none; width: var(--banner-dot-size); height: var(--banner-dot-size); border-radius: var(--borderRadius-pill); background: var(--banner-dot-bg); }
</style>
