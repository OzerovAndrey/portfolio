---
// Мета-кейс Aurum Multibrand (BRIEF.md → «/cases/* — формат»): контекст · проблема (3) · рішення (схема) · результат (3 числа з реєстру) · інакше.
// Цифри — з tokens/demo через білд (src/generated/demo/meta.json), не руками. Скріни — з маніфесту shots.json.
import Base from "../../../layouts/Base.astro";
import Button from "../../../components/Button.astro";
import Icon from "../../../components/Icon.astro";
import Shot from "../../../components/Shot.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import meta from "../../../generated/demo/meta.json";
import { config } from "../../../config";
import { href, staticLangPaths, t, type Locale } from "../../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
const c = d.caseAurum;
const k = meta.counts;
const brandKeys = k.brand / meta.brandCount;
const vars: Record<string, number> = { brands: meta.brandCount, components: meta.componentCount, brandKeys, combos: meta.comboCount };
const fill = (s: string) => s.replace(/\{(\w+)\}/g, (_, x) => String(vars[x] ?? ""));
const layers = [
  { id: "components", n: k.components, unit: `· ${meta.componentCount} ${c.componentsUnit}` },
  { id: "theme", n: k.theme / 2, unit: "× 2" },
  { id: "typography", n: k.typography },
  { id: "map", n: k.map },
  { id: "brand", n: brandKeys, unit: `× ${meta.brandCount}`, hi: true },
  { id: "core", n: k.core },
] as const;
const PROBLEM_ICON = ["component", "grid", "branch"] as const;

// Факти кейсу: роль · обсяг (матриця бренди × теми з реальних кадрів демо) · стек · статус
const FACT_ICON = ["user", "grid", "wrench", "activity"] as const;
const ROLE_ICON = ["pen", "component", "tokens"] as const;
const STACK_ICON = ["figma", "tokens", "github", "code", "braces"] as const;
const MATRIX_BRANDS = ["aurum", "nova", "fiesta", "ultra"] as const;
const matrixFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/cases/matrix/*.webp", { eager: true });
const matrix = (["light", "dark"] as const).flatMap((th) => MATRIX_BRANDS.map((b) => matrixFiles[`/src/assets/cases/matrix/${b}-${th}.webp`].default));
const repoUrl = config.contacts.github ? `${config.contacts.github}/multibrand-design-system` : "";
const [fRole, fScope, fStack, fStatus] = c.facts;
---
<Base lang={lang} page="cases" title={d.meta.caseAurumTitle} description={d.meta.caseAurumDescription}>
  <section class="section">
    <div class="container stack">
      <a class="cs-back ts-label-md" href={href(lang, "cases")}><Icon name="arrowRight" class="cs-back__icon" />{c.backToWork}</a>
      <div class="section__head">
        <span class="cs-tag ts-label-sm">{c.tag}</span>
        <h1 class="section__title ts-display-d3">{c.title}</h1>
        <p class="section__lead ts-body-lg-regular measure--lead">{c.lead}</p>
      </div>
      <dl class="cs-facts">
        <div class="cs-fact cs-fact--scope">
          <dt class="cs-fact__head"><span class="cs-fact__badge"><Icon name={FACT_ICON[1]} /></span><span class="ts-label-md">{fScope.k}</span></dt>
          <dd class="cs-fact__body">
            <div class="cs-matrix" role="img" aria-label={fill(fScope.items[0])}>
              {matrix.map((img) => <Image src={img} alt="" widths={[160, 320]} sizes="(min-width: 1024px) 12vw, 25vw" loading="lazy" decoding="async" class="cs-matrix__tile" />)}
            </div>
            <ul class="cs-chips">{fScope.items.map((x) => <li class="cs-chip ts-label-md">{fill(x)}</li>)}</ul>
          </dd>
        </div>
        <div class="cs-fact cs-fact--role">
          <dt class="cs-fact__head"><span class="cs-fact__badge"><Icon name={FACT_ICON[0]} /></span><span class="ts-label-md">{fRole.k}</span></dt>
          <dd class="cs-fact__body"><ul class="cs-chips">{fRole.items.map((x, i) => <li class="cs-chip ts-label-md"><Icon name={ROLE_ICON[i] ?? "pen"} class="cs-chip__icon" />{x}</li>)}</ul></dd>
        </div>
        <div class="cs-fact cs-fact--status">
          <dt class="cs-fact__head"><span class="cs-fact__badge"><Icon name={FACT_ICON[3]} /></span><span class="ts-label-md">{fStatus.k}</span></dt>
          <dd class="cs-fact__body"><ul class="cs-chips">
            <li><a class="cs-chip cs-chip--link ts-label-md" href={config.demoUrl} target="_blank" rel="noopener" data-event="case_aurum_status_demo"><span class="cs-live" aria-hidden="true"></span>{fStatus.items[0]}</a></li>
            {repoUrl && <li><a class="cs-chip cs-chip--link ts-label-md" href={repoUrl} target="_blank" rel="noopener" data-event="case_aurum_status_repo"><Icon name="github" class="cs-chip__icon" />{fStatus.items[1]}</a></li>}
          </ul></dd>
        </div>
        <div class="cs-fact cs-fact--stack">
          <dt class="cs-fact__head"><span class="cs-fact__badge"><Icon name={FACT_ICON[2]} /></span><span class="ts-label-md">{fStack.k}</span></dt>
          <dd class="cs-fact__body"><ul class="cs-chips">{fStack.items.map((x, i) => <li class="cs-chip ts-label-md"><Icon name={STACK_ICON[i] ?? "code"} class="cs-chip__icon" />{x}</li>)}</ul></dd>
        </div>
      </dl>
      <div class="cs-actions">
        <Button size="lg" icon="arrowUpRight" href={config.demoUrl} target="_blank" rel="noopener" data-event="case_aurum_demo">{c.ctaDemo}</Button>
        <Button size="lg" variant="secondary" icon="arrowRight" href={href(lang, "approach")} data-event="case_aurum_approach">{c.ctaApproach}</Button>
      </div>
      <Shot id="comp-four-brands" lang={lang} sizes="(min-width: 1280px) 1232px, 100vw" loading="eager" />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cs-context" data-reveal>
    <div class="container cs-split">
      <h2 class="section__title ts-title-t1" id="cs-context">{c.contextTitle}</h2>
      <p class="cs-prose ts-body-lg-regular">{c.context}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="cs-problem" data-reveal>
    <div class="container stack">
      <h2 class="section__title ts-title-t1" id="cs-problem">{c.problemTitle}</h2>
      <ol class="cs-grid3">
        {c.problems.map((p, i) => (
          <li class="info-card">
            <span class="info-card__head"><Icon name={PROBLEM_ICON[i] ?? "alert"} class="info-card__icon" /><span class="info-card__label ts-label-sm">0{i + 1}</span></span>
            <h3 class="info-card__title ts-title-t4">{p.title}</h3>
            <p class="info-card__detail ts-body-md-regular">{p.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cs-solution" data-reveal>
    <div class="container stack">
      <div class="section__head">
        <h2 class="section__title ts-title-t1" id="cs-solution">{c.solutionTitle}</h2>
        <p class="section__lead ts-body-lg-regular measure--lead">{c.solutionLead}</p>
      </div>
      <ol class="cs-layers" aria-label={c.layersLabel}>
        {layers.map((l) => (
          <li class:list={["cs-layer", "hi" in l && l.hi && "cs-layer--hi"]}>
            <span class="cs-layer__name ts-label-lg">{l.id}</span>
            <span class="cs-layer__detail ts-body-sm-regular">{c.layers[l.id]}</span>
            <span class="cs-layer__count ts-label-md">{l.n}{"unit" in l && l.unit ? <span class="cs-layer__unit"> {l.unit}</span> : null}</span>
            {"hi" in l && l.hi && <span class="cs-layer__tag ts-label-sm">{c.brandNote}</span>}
          </li>
        ))}
      </ol>
      <div class="cs-shots">
        {["figma-variables-modes", "git-diff-ultra"].map((id, i) => (
          <figure class="cs-shot">
            <Shot id={id} lang={lang} sizes="(min-width: 1024px) 50vw, 100vw" />
            <figcaption class="cs-shot__cap ts-body-sm-regular">{c.shotsCaption[i]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cs-result" data-reveal>
    <div class="container stack">
      <h2 class="section__title ts-title-t1" id="cs-result">{c.resultTitle}</h2>
      <ul class="cs-grid3">
        {c.results.map((r) => (
          <li class="cs-metric">
            <span class="cs-metric__amount ts-display-d2">{fill(r.amount)}</span>
            <span class="cs-metric__label ts-title-t4">{r.label}</span>
            <span class="cs-metric__detail ts-body-md-regular">{r.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cs-different" data-reveal>
    <div class="container cs-split">
      <h2 class="section__title ts-title-t1" id="cs-different">{c.differentTitle}</h2>
      <div class="stack">
        <p class="cs-prose ts-body-lg-regular">{c.different}</p>
        <div class="cs-actions">
          <Button size="lg" icon="mail" href={href(lang, "contact")} data-event="case_aurum_contact">{c.ctaContact}</Button>
          <Button size="lg" variant="secondary" icon="arrowUpRight" href={config.demoUrl} target="_blank" rel="noopener" data-event="case_aurum_demo_end">{c.ctaDemo}</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cs-back { display: inline-flex; align-items: center; gap: var(--space-gap-sm); color: var(--section-lead-color); text-decoration: none; }
  .cs-back:hover { color: var(--section-title-color); }
  .cs-back :global(.cs-back__icon) { --icon-size: var(--iconSize-sm); transform: scaleX(-1); }
  .cs-tag { align-self: flex-start; display: inline-flex; align-items: center; height: var(--caseCard-tag-size); padding-inline: var(--caseCard-tag-paddingH); background: var(--caseCard-tag-bg); color: var(--caseCard-tag-color); border-radius: var(--caseCard-tag-borderRadius); }
  /* Факти кейсу — bento: обсяг із матрицею брендів ліворуч, роль/статус/стек праворуч */
  .cs-facts { display: grid; gap: var(--l-gap); margin: 0; grid-template-areas: "scope" "role" "status" "stack"; }
  @media (min-width: 768px) { .cs-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "scope role" "scope status" "stack stack"; } }
  @media (min-width: 1024px) { .cs-facts { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 4fr); grid-template-areas: "scope role status" "scope stack stack"; } }
  .cs-fact--scope { grid-area: scope; } .cs-fact--role { grid-area: role; } .cs-fact--status { grid-area: status; } .cs-fact--stack { grid-area: stack; }
  .cs-fact { display: flex; flex-direction: column; gap: var(--caseFact-gap); padding: var(--caseFact-padding); background: var(--caseFact-bg); border: var(--caseFact-borderWidth) solid var(--caseFact-br); border-radius: var(--caseFact-borderRadius); }
  .cs-fact__head { display: flex; align-items: center; gap: var(--space-gap-md); color: var(--caseFact-label-color); }
  .cs-fact__badge { display: inline-grid; place-items: center; flex: none; width: var(--caseFact-badge-size); height: var(--caseFact-badge-size); background: var(--caseFact-badge-bg); color: var(--caseFact-badge-color); border-radius: var(--caseFact-badge-borderRadius); --icon-size: var(--iconSize-md); }
  .cs-fact__body { margin: 0; display: flex; flex-direction: column; gap: var(--caseFact-gap); flex: 1; justify-content: flex-end; }
  .cs-fact--role .cs-fact__body, .cs-fact--status .cs-fact__body, .cs-fact--stack .cs-fact__body { justify-content: flex-start; }

  .cs-matrix { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--caseFact-matrix-gap); }
  .cs-matrix :global(.cs-matrix__tile) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--caseFact-matrix-borderRadius); }

  .cs-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--caseFact-chip-gap); }
  .cs-chip { display: inline-flex; align-items: center; gap: var(--caseFact-chip-gap); min-height: var(--caseFact-chip-size); padding-inline: var(--caseFact-chip-paddingH); background: var(--caseFact-chip-bg); color: var(--caseFact-chip-color); border: var(--caseFact-borderWidth) solid var(--caseFact-chip-br); border-radius: var(--caseFact-chip-borderRadius); text-decoration: none; }
  .cs-chip :global(.cs-chip__icon) { --icon-size: var(--iconSize-sm); flex: none; }
  .cs-chip--link { transition: border-color var(--motion-duration-fast) var(--motion-easing-out); }
  .cs-chip--link:hover { border-color: var(--caseCard-br-hover); }
  .cs-live { position: relative; width: var(--space-gap-md); height: var(--space-gap-md); border-radius: var(--borderRadius-pill); background: var(--caseFact-live-color); flex: none; }
  .cs-live::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: var(--caseFact-live-color); animation: cs-live-pulse calc(var(--motion-duration-slow) * 4) var(--motion-easing-out) infinite; }
  @keyframes cs-live-pulse { from { transform: scale(1); opacity: 0.6; } to { transform: scale(2.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cs-live::after { animation: none; } }
  .cs-actions { display: flex; flex-wrap: wrap; gap: var(--space-gap-md); }

  .cs-split { display: grid; gap: var(--section-text-heading) var(--l-gap); }
  @media (min-width: 1024px) { .cs-split { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); align-items: start; } }
  .cs-prose { color: var(--section-lead-color); max-width: var(--layout-measure-body); margin: 0; }

  .cs-grid3 { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--l-gap); }
  @media (min-width: 900px) { .cs-grid3 { grid-template-columns: repeat(3, 1fr); } }

  .cs-layers { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--layerStack-gap); }
  .cs-layer {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--layerStack-item-gap) var(--l-gap); align-items: center;
    padding: var(--layerStack-item-padding); background: var(--layerStack-item-bg);
    border: var(--layerStack-item-borderWidth) solid var(--layerStack-item-br); border-radius: var(--layerStack-item-borderRadius);
  }
  @media (min-width: 768px) { .cs-layer { grid-template-columns: minmax(0, 1fr) minmax(0, 3fr) auto auto; } }
  .cs-layer__name { color: var(--layerStack-name-color); }
  .cs-layer__detail { color: var(--layerStack-detail-color); }
  .cs-layer__count { color: var(--layerStack-count-color); white-space: nowrap; text-align: end; }
  .cs-layer__unit { color: var(--layerStack-detail-color); }
  .cs-layer__tag { padding-inline: var(--layerStack-tag-paddingH); background: var(--layerStack-tag-bg); color: var(--layerStack-tag-color); border-radius: var(--layerStack-tag-borderRadius); white-space: nowrap; }
  .cs-layer--hi { background: var(--layerStack-highlight-bg); border-color: var(--layerStack-highlight-br); }
  @media (max-width: 767px) { .cs-layer__detail { grid-column: 1 / -1; } }

  .cs-shots { display: grid; gap: var(--l-gap); }
  @media (min-width: 1024px) { .cs-shots { grid-template-columns: repeat(2, 1fr); } }
  .cs-shot { margin: 0; display: flex; flex-direction: column; gap: var(--space-gap-md); }
  .cs-shot__cap { color: var(--section-lead-color); }

  .cs-metric { display: flex; flex-direction: column; gap: var(--metric-gap); padding: var(--metric-padding); background: var(--metric-bg); border: var(--metric-borderWidth) solid var(--metric-br); border-radius: var(--metric-borderRadius); }
  .cs-metric__amount { color: var(--metric-amount-color); letter-spacing: var(--metric-amount-letterSpacing); }
  .cs-metric__label { color: var(--section-title-color); }
  .cs-metric__detail { color: var(--metric-label-color); }
</style>
