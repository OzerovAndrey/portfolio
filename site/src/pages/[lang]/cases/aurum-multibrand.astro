---
// Мета-кейс Aurum Multibrand (BRIEF.md → «/cases/* — формат»): контекст · проблема (3) · рішення (схема) · результат (3 числа з реєстру) · інакше.
// Цифри — з tokens/demo через білд (src/generated/demo/meta.json), не руками. Скріни — з маніфесту shots.json.
import Base from "../../../layouts/Base.astro";
import Button from "../../../components/Button.astro";
import Icon from "../../../components/Icon.astro";
import Shot from "../../../components/Shot.astro";
import meta from "../../../generated/demo/meta.json";
import { config } from "../../../config";
import { href, staticLangPaths, t, type Locale } from "../../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
const c = d.caseAurum;
const k = meta.counts;
const brandKeys = k.brand / meta.brandCount;
const vars: Record<string, number> = { brands: meta.brandCount, components: meta.componentCount, brandKeys, combos: meta.comboCount };
const fill = (s: string) => s.replace(/\{(\w+)\}/g, (_, x) => String(vars[x] ?? ""));
const layers = [
  { id: "components", n: k.components, unit: `· ${meta.componentCount} ${c.componentsUnit}` },
  { id: "theme", n: k.theme / 2, unit: "× 2" },
  { id: "typography", n: k.typography },
  { id: "map", n: k.map },
  { id: "brand", n: brandKeys, unit: `× ${meta.brandCount}`, hi: true },
  { id: "core", n: k.core },
] as const;
const PROBLEM_ICON = ["component", "grid", "branch"] as const;

// Факти кейсу: 4 прості картки з іконкою. Порядок показу — обсяг · роль · статус · стек (у i18n: роль · обсяг · стек · статус)
const FACTS = [{ i: 1, icon: "grid" }, { i: 0, icon: "user" }, { i: 3, icon: "activity" }, { i: 2, icon: "wrench" }] as const;
---
<Base lang={lang} page="cases" title={d.meta.caseAurumTitle} description={d.meta.caseAurumDescription}>
  <section class="section">
    <div class="container stack">
      <a class="cs-back ts-label-md" href={href(lang, "cases")}><Icon name="arrowRight" class="cs-back__icon" />{c.backToWork}</a>
      <div class="section__head">
        <span class="cs-tag ts-label-sm">{c.tag}</span>
        <h1 class="section__title ts-display-d3 text-shimmer">{c.title}</h1>
        <p class="section__lead ts-body-lg-regular measure--lead">{c.lead}</p>
      </div>
      <dl class="cs-facts">
        {FACTS.map(({ i, icon }) => (
          <div class="cs-fact">
            <span class="cs-fact__badge" aria-hidden="true"><Icon name={icon} /></span>
            <dt class="cs-fact__label ts-label-md">{c.facts[i].k}</dt>
            <dd class="cs-fact__value ts-body-md-regular">{c.facts[i].items.map((x) => fill(x).replace(/(\d) /g, "$1\u00a0")).join("\u00a0· ")}</dd>
          </div>
        ))}
      </dl>
      <div class="cs-actions">
        <Button size="lg" icon="arrowUpRight" href={config.demoUrl} target="_blank" rel="noopener" data-event="case_aurum_demo">{c.ctaDemo}</Button>
        <Button size="lg" variant="secondary" icon="arrowRight" href={href(lang, "approach")} data-event="case_aurum_approach">{c.ctaApproach}</Button>
      </div>
      <Shot id="comp-four-brands" lang={lang} sizes="(min-width: 1280px) 1232px, 100vw" loading="eager" />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cs-context" data-reveal>
    <div class="container cs-split">
      <h2 class="section__title ts-title-t1" id="cs-context">{c.contextTitle}</h2>
      <p class="cs-prose ts-body-lg-regular">{c.context}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="cs-problem" data-reveal>
    <div class="container stack">
      <h2 class="section__title ts-title-t1" id="cs-problem">{c.problemTitle}</h2>
      <ol class="cs-grid3">
        {c.problems.map((p, i) => (
          <li class="info-card">
            <Icon name={PROBLEM_ICON[i] ?? "alert"} class="info-card__icon" />
            <h3 class="info-card__title ts-title-t4">{p.title}</h3>
            <p class="info-card__detail ts-body-md-regular">{p.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cs-solution" data-reveal>
    <div class="container stack">
      <div class="section__head">
        <h2 class="section__title ts-title-t1" id="cs-solution">{c.solutionTitle}</h2>
        <p class="section__lead ts-body-lg-regular measure">{c.solutionLead}</p>
      </div>
      <ol class="cs-layers" aria-label={c.layersLabel}>
        {layers.map((l) => (
          <li class:list={["cs-layer", "hi" in l && l.hi && "cs-layer--hi"]}>
            <span class="cs-layer__name ts-label-lg">{l.id}</span>
            <span class="cs-layer__detail ts-body-sm-regular">{c.layers[l.id]}</span>
            <span class="cs-layer__count ts-label-md">{l.n}{"unit" in l && l.unit ? <span class="cs-layer__unit"> {l.unit}</span> : null}</span>
            {"hi" in l && l.hi && <span class="cs-layer__tag ts-label-sm">{c.brandNote}</span>}
          </li>
        ))}
      </ol>
      <div class="cs-shots">
        {["figma-variables-modes", "git-diff-ultra"].map((id, i) => (
          <figure class="cs-shot">
            <Shot id={id} lang={lang} sizes="(min-width: 1024px) 50vw, 100vw" />
            <figcaption class="cs-shot__cap ts-body-sm-regular">{c.shotsCaption[i]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cs-result" data-reveal>
    <div class="container stack">
      <h2 class="section__title ts-title-t1" id="cs-result">{c.resultTitle}</h2>
      <ul class="cs-grid3">
        {c.results.map((r) => (
          <li class="cs-metric">
            <span class="cs-metric__amount ts-display-d2">{fill(r.amount)}</span>
            <span class="cs-metric__label ts-title-t4">{r.label}</span>
            <span class="cs-metric__detail ts-body-md-regular">{r.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cs-different" data-reveal>
    <div class="container cs-split">
      <h2 class="section__title ts-title-t1" id="cs-different">{c.differentTitle}</h2>
      <div class="stack">
        <p class="cs-prose ts-body-lg-regular">{c.different}</p>
        <div class="cs-actions">
          <Button size="lg" icon="mail" href={href(lang, "contact")} data-event="case_aurum_contact">{c.ctaContact}</Button>
          <Button size="lg" variant="secondary" icon="arrowUpRight" href={config.demoUrl} target="_blank" rel="noopener" data-event="case_aurum_demo_end">{c.ctaDemo}</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cs-back { display: inline-flex; align-items: center; gap: var(--space-gap-sm); color: var(--section-lead-color); text-decoration: none; }
  .cs-back:hover { color: var(--section-title-color); }
  .cs-back :global(.cs-back__icon) { --icon-size: var(--iconSize-sm); transform: scaleX(-1); }
  .cs-tag { align-self: flex-start; display: inline-flex; align-items: center; height: var(--caseCard-tag-size); padding-inline: var(--caseCard-tag-paddingH); background: var(--caseCard-tag-bg); color: var(--caseCard-tag-color); border-radius: var(--caseCard-tag-borderRadius); }
  /* Факти кейсу — 4 картки в рядок */
  .cs-facts { display: grid; gap: var(--l-gap); margin: 0; }
  @media (min-width: 768px) { .cs-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .cs-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cs-fact { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-gap-md); padding: var(--caseFact-padding); background: var(--caseFact-bg); border: var(--caseFact-borderWidth) solid var(--caseFact-br); border-radius: var(--caseFact-borderRadius); }
  .cs-fact__badge { display: inline-grid; place-items: center; width: var(--caseFact-badge-size); height: var(--caseFact-badge-size); margin-bottom: var(--space-gap-md); background: var(--caseFact-badge-bg); color: var(--caseFact-badge-color); border-radius: var(--caseFact-badge-borderRadius); --icon-size: var(--iconSize-md); }
  .cs-fact__label { color: var(--caseFact-label-color); }
  .cs-fact__value { margin: 0; color: var(--caseFact-text-color); }
  .cs-actions { display: flex; flex-wrap: wrap; gap: var(--space-gap-md); }

  .cs-split { display: grid; gap: var(--section-text-heading) var(--l-gap); }
  @media (min-width: 1024px) { .cs-split { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); align-items: start; } }
  .cs-prose { color: var(--section-lead-color); max-width: var(--layout-measure-body); margin: 0; }

  .cs-grid3 { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--l-gap); }
  @media (min-width: 900px) { .cs-grid3 { grid-template-columns: repeat(3, 1fr); } }

  .cs-layers { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--layerStack-gap); }
  .cs-layer {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--layerStack-item-gap) var(--l-gap); align-items: center;
    padding: var(--layerStack-item-padding); background: var(--layerStack-item-bg);
    border: var(--layerStack-item-borderWidth) solid var(--layerStack-item-br); border-radius: var(--layerStack-item-borderRadius);
  }
  /* ≥ 768: одна сітка на весь список (subgrid) — опис і числа стоять в одну лінію в усіх рядках */
  @media (min-width: 768px) {
    .cs-layers { grid-template-columns: minmax(max-content, 1fr) minmax(0, 3fr) auto auto; column-gap: var(--l-gap); }
    .cs-layer { grid-column: 1 / -1; grid-template-columns: subgrid; }
  }
  .cs-layer__name { color: var(--layerStack-name-color); }
  .cs-layer__detail { color: var(--layerStack-detail-color); }
  .cs-layer__count { color: var(--layerStack-count-color); white-space: nowrap; text-align: end; }
  .cs-layer__unit { color: var(--layerStack-detail-color); }
  .cs-layer__tag { padding-inline: var(--layerStack-tag-paddingH); background: var(--layerStack-tag-bg); color: var(--layerStack-tag-color); border-radius: var(--layerStack-tag-borderRadius); white-space: nowrap; }
  .cs-layer--hi { background: var(--layerStack-highlight-bg); border-color: var(--layerStack-highlight-br); }
  @media (max-width: 767px) { .cs-layer__detail { grid-column: 1 / -1; } }

  .cs-shots { display: grid; gap: var(--l-gap); }
  @media (min-width: 1024px) { .cs-shots { grid-template-columns: repeat(2, 1fr); } }
  .cs-shot { margin: 0; display: flex; flex-direction: column; gap: var(--space-gap-md); }
  .cs-shot__cap { color: var(--section-lead-color); }

  .cs-metric { display: flex; flex-direction: column; gap: var(--metric-gap); padding: var(--metric-padding); background: var(--metric-bg); border: var(--metric-borderWidth) solid var(--metric-br); border-radius: var(--metric-borderRadius); }
  .cs-metric__amount { color: var(--metric-amount-color); letter-spacing: var(--metric-amount-letterSpacing); }
  .cs-metric__label { color: var(--section-title-color); }
  .cs-metric__detail { color: var(--metric-label-color); }
</style>
