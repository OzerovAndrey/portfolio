---
// /about: людина за системою. Тільки підтверджене (BRIEF.md, розділ 3 і 6): без років досвіду й назв клієнтів (NDA).
// Портрет: покласти src/assets/about/portrait.(jpg|png|webp) — з'явиться замість монограми без правок коду.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import { config, links, formatPhone, career, yearsSince } from "../../config";
import { href, staticLangPaths, t, type Locale } from "../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
const a = d.about;
const portrait = Object.values(import.meta.glob<{ default: ImageMetadata }>("/src/assets/about/portrait.{jpg,jpeg,png,webp}", { eager: true }))[0]?.default;
// Роки — від дат кар'єри (config.career, джерело LinkedIn), рахуються при білді; форма слова — Intl.PluralRules
const nums: Record<string, number> = { years: yearsSince(career.start), igaming: yearsSince(career.igaming) };
const pr = new Intl.PluralRules(lang);
type Forms = Record<"one" | "few" | "many" | "other", string>;
const word = (f: Forms, n: number) => f[pr.select(n) as keyof Forms] ?? f.other;
const fillN = (s: string) => s.replace(/\{(years|igaming)\}/g, (_, k) => String(nums[k])).replace("{yearsWord}", word(a.experience.yearsWord, nums.years));
const ct = config.contacts;
const contacts = links(
  [ct.email, ct.email && `mailto:${ct.email}`, "mail"],
  ["Telegram", ct.telegram, "send"],
  ["LinkedIn", ct.linkedin, "linkedin"],
  ["GitHub", ct.github, "github"],
  [ct.phone && formatPhone(ct.phone), ct.phone && `tel:${ct.phone}`, "phone"],
);
---
<Base lang={lang} page="about" title={d.meta.aboutTitle} description={d.meta.aboutDescription}>
  <section class="section">
    <div class="container ab-intro">
      <div class="section__head ab-head">
        <h1 class="section__title ts-display-d3 text-shimmer">{a.title}</h1>
        <p class="section__lead ts-body-lg-regular measure--lead">{a.lead}</p>
      </div>
        <figure class:list={["ab-portrait", portrait && "ab-portrait--avatar"]}>
          {portrait
            ? <Image src={portrait} alt={a.portraitAlt} widths={[480, Math.min(800, portrait.width), Math.min(1200, portrait.width)]} quality={90} sizes="(min-width: 900px) 40vw, 100vw" loading="eager" class="ab-portrait__img" />
            : <span class="ab-portrait__mono ts-display-d1" aria-hidden="true">{a.monogram}</span>}
          <figcaption class:list={["ab-portrait__cap", portrait && "ab-portrait__cap--below"]}><span class="ts-title-t4">{a.name}</span><span class="ts-body-sm-regular">{a.role}</span></figcaption>
        </figure>
      <div class="ab-text">
        <p class="ab-statement ts-title-t1 text-shimmer">{a.statement}</p>
        <p class="ab-prose ts-body-lg-regular">{a.paragraph}</p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ab-exp" data-reveal>
    <div class="container ab-split">
      <h2 class="section__title ts-title-t1 text-shimmer" id="ab-exp">{a.experience.title}</h2>
      <div class="stack">
        <p class="ab-prose ts-body-lg-regular">{fillN(a.experience.detail)}</p>
        <ul class="ab-stats">
          {a.experience.stats.map((x) => { const n = x.n ? nums[x.n] : Number(x.amount); return (
            <li class="ab-stat"><span class="ab-stat__amount ts-display-d3">{fillN(x.amount)}</span><span class="ab-stat__label ts-body-sm-regular">{word(x.label, n)}</span></li>); })}
        </ul>
        <ol class="ab-timeline" aria-label={a.experience.timelineLabel}>
          {a.experience.timeline.map((x) => (
            <li class="ab-tl">
              <span class="ab-tl__years ts-label-md">{x.years}</span>
              <span class="ab-tl__body">
                <span class="ab-tl__role ts-title-t4">{x.role}</span><span class="ab-tl__org ts-body-sm-regular">{x.org}</span><span class="ab-tl__detail ts-body-md-regular">{x.detail}</span>
                {x.highlights.length > 0 && (
                  <span class="ab-hl">{x.highlights.map((h) => (<span class="ab-hl__item"><span class="ab-hl__title ts-label-lg">{h.title}</span><span class="ab-hl__detail ts-body-sm-regular">{h.detail}</span></span>))}</span>
                )}
              </span>
            </li>
          ))}
        </ol>
        <p class="ab-source ts-body-sm-regular">{a.experience.source}</p>
        <ul class="ab-tags">{a.experience.items.map((x) => <li class="ab-tag ts-label-md">{x}</li>)}</ul>
        <div><Button variant="secondary" size="md" icon="arrowRight" href={href(lang, "cases/aurum-multibrand")} data-event="about_case">{a.experience.link}</Button></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ab-tools" data-reveal>
    <div class="container stack">
      <h2 class="section__title ts-title-t1 text-shimmer" id="ab-tools">{a.tools.title}</h2>
      <ul class="ab-grid3">
        {a.tools.items.map((x) => (
          <li class="info-card"><h3 class="info-card__title ts-title-t4">{x.name}</h3><p class="info-card__detail ts-body-md-regular">{x.detail}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ab-principles" data-reveal>
    <div class="container stack">
      <h2 class="section__title ts-title-t1 text-shimmer" id="ab-principles">{a.principles.title}</h2>
      <ol class="info-grid">
        {a.principles.items.map((x, i) => (
          <li class="info-card">
            <span class="info-card__label ts-label-sm">0{i + 1}</span>
            <h3 class="info-card__title ts-title-t4">{x.title}</h3>
            <p class="info-card__detail ts-body-md-regular">{x.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="ab-contact" data-reveal>
    <div class="container ab-split">
      <div class="section__head">
        <h2 class="section__title ts-title-t1 text-shimmer" id="ab-contact">{a.contact.title}</h2>
        <p class="section__lead ts-body-lg-regular">{a.contact.lead}</p>
      </div>
      <div class="stack">
        <ul class="ab-contacts">
          {contacts.map((l) => (
            <li><a class="ab-contact ts-body-lg-regular" href={l.url} target={l.url.startsWith("http") ? "_blank" : undefined} rel={l.url.startsWith("http") ? "noopener" : undefined} data-event={`about_contact_${(l.icon ?? "link")}`}>
              {l.icon && <Icon name={l.icon} class="ab-contact__icon" />}<span>{l.label}</span><Icon name="arrowUpRight" class="ab-contact__go" />
            </a></li>
          ))}
        </ul>
        <div><Button size="lg" icon="mail" href={href(lang, "contact")} data-event="about_cta">{a.contact.cta}</Button></div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Текст ліворуч (заголовок → лід → теза → абзац), портрет праворуч на всю висоту блоку; на вузьких: заголовок → фото → текст */
  .ab-intro { display: grid; gap: var(--section-text-block) var(--l-gap); grid-template-areas: "head" "photo" "text"; }
  .ab-head { grid-area: head; margin-bottom: 0; }
  .ab-portrait { grid-area: photo; }
  .ab-text { grid-area: text; }
  @media (min-width: 900px) {
    .ab-intro { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); grid-template-rows: auto 1fr; grid-template-areas: "head photo" "text photo"; column-gap: var(--layout-section-padding, var(--l-gap)); }
    .ab-portrait { max-width: none; }
    .ab-text { justify-content: flex-start; }
  }
  /* width + align-self: Safari рахує ширину з aspect-ratio і розтягнутої висоти рядка сітки → вузька смужка */
  .ab-portrait { position: relative; margin: 0; width: 100%; max-width: var(--layout-measure-lead); align-self: start; aspect-ratio: 4 / 5; display: grid; place-items: center; overflow: hidden;
    background: var(--metric-bg); border: var(--metric-borderWidth) solid var(--metric-br); border-radius: var(--metric-borderRadius); }
  .ab-portrait :global(.ab-portrait__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: var(--portrait-filter); }
  .ab-portrait__mono { color: var(--section-title-color); letter-spacing: var(--metric-amount-letterSpacing); }
  .ab-portrait__cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: var(--space-gap-xs);
    padding: var(--space-padding-lg); color: var(--section-title-color); }
  .ab-portrait__cap span:last-child { color: var(--section-lead-color); }
  /* 3D-аватар з прозорим фоном: без рамки й пропорції 4:5, картинка у своїх пропорціях, підпис — під нею */
  .ab-portrait--avatar { aspect-ratio: auto; display: flex; flex-direction: column; align-items: center; gap: var(--section-text-heading); overflow: visible;
    background: none; border: 0; border-radius: 0; }
  .ab-portrait--avatar :global(.ab-portrait__img) { position: static; width: 100%; height: auto; object-fit: contain; }
  .ab-portrait__cap--below { position: static; padding: 0; align-items: center; text-align: center; }
  .ab-text { display: flex; flex-direction: column; gap: var(--section-text-heading); }
  .ab-statement { margin: 0; color: var(--section-title-color); text-wrap: balance; }
  .ab-prose { margin: 0; color: var(--section-lead-color); max-width: var(--layout-measure-body); }
  .ab-split { display: grid; gap: var(--section-text-heading) var(--l-gap); }
  @media (min-width: 1024px) { .ab-split { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); align-items: start; } }
  .ab-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-gap-md); }
  .ab-tag { display: inline-flex; align-items: center; height: var(--caseCard-tag-size); padding-inline: var(--caseCard-tag-paddingH);
    background: var(--caseCard-tag-bg); color: var(--caseCard-tag-color); border-radius: var(--caseCard-tag-borderRadius); }
  .ab-grid3 { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--l-gap); }
  @media (min-width: 768px) { .ab-grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ab-grid3 { grid-template-columns: repeat(3, 1fr); } }
  .ab-contacts { list-style: none; margin: 0; padding: 0; display: grid; border-top: var(--metric-borderWidth) solid var(--metric-br); }
  .ab-contact { display: flex; align-items: center; gap: var(--space-gap-lg); padding-block: var(--space-padding-md);
    border-bottom: var(--metric-borderWidth) solid var(--metric-br); color: var(--section-title-color); text-decoration: none; }
  .ab-contact:hover span { text-decoration: underline; text-underline-offset: var(--space-gap-xs); }
  .ab-contact :global(.ab-contact__icon) { --icon-size: var(--iconSize-md); color: var(--section-lead-color); }
  .ab-contact :global(.ab-contact__go) { --icon-size: var(--iconSize-sm); margin-left: auto; color: var(--section-lead-color);
    transition: transform var(--motion-duration-fast) var(--motion-easing-out); }
  .ab-contact:hover :global(.ab-contact__go) { transform: translate(var(--motion-nudge), calc(var(--motion-nudge) * -1)); }
  .ab-stats { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--l-gap); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 600px) { .ab-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* вузькі: число й підпис в один рядок */
  @media (max-width: 599px) { .ab-stat { flex-direction: row; align-items: baseline; gap: var(--space-gap-lg); } }
  .ab-stat { display: flex; flex-direction: column; gap: var(--space-gap-sm); padding-top: var(--space-padding-md); border-top: var(--metric-borderWidth) solid var(--metric-br); }
  .ab-stat__amount { color: var(--metric-amount-color); letter-spacing: var(--metric-amount-letterSpacing); }
  .ab-stat__label { color: var(--metric-label-color); }
  .ab-timeline { list-style: none; margin: 0; padding: 0; display: grid; border-top: var(--metric-borderWidth) solid var(--metric-br); }
  .ab-tl { display: grid; gap: var(--space-gap-sm) var(--l-gap); padding-block: var(--space-padding-md); border-bottom: var(--metric-borderWidth) solid var(--metric-br); }
  @media (min-width: 768px) { .ab-tl { grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); } }
  .ab-tl__years { color: var(--metric-label-color); }
  .ab-tl__body { display: flex; flex-direction: column; gap: var(--space-gap-xs); }
  .ab-tl__role { color: var(--section-title-color); }
  .ab-tl__org { color: var(--section-lead-color); }
  .ab-tl__detail { color: var(--section-lead-color); }
  .ab-source { margin: 0; color: var(--metric-label-color); }
  /* Поточна роль розписана: 4 напрями сіткою 2×2 + навички. Заголовок → текст 24, між блоками 48 */
  .ab-tl--lead .ab-tl__body { gap: var(--space-gap-sm); }
  .ab-hl { display: grid; gap: var(--section-text-heading) var(--l-gap); margin-top: var(--section-text-heading); padding: var(--audience-padding);
    background: var(--audience-bg); border: var(--audience-borderWidth) solid var(--audience-br); border-radius: var(--audience-borderRadius); }
  @media (min-width: 768px) { .ab-hl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* без розділювача над першим рядком: на вузьких — перший пункт, з 768 — два перші */
  .ab-hl__item:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 768px) { .ab-hl__item:nth-child(-n + 2) { border-top: 0; padding-top: 0; } }
  .ab-hl__item { display: flex; flex-direction: column; gap: var(--space-gap-md); padding-top: var(--space-padding-md); border-top: var(--metric-borderWidth) solid var(--metric-br); }
  .ab-hl__title { color: var(--section-title-color); }
  .ab-hl__detail { color: var(--section-lead-color); }
</style>
