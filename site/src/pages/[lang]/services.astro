---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
import ProcessFlow from "../../components/ProcessFlow.astro";
import { href, staticLangPaths, t, type Locale } from "../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
const s = d.services;
const PKG = ["clipboard", "braces", "layers", "branch"] as const; // аудит · токени · система · пайплайн
---
<Base lang={lang} page="services" title={d.meta.servicesTitle} description={d.meta.servicesDescription}>
  <section class="section">
    <div class="container stack">
      <div class="section__head">
        <h1 class="section__title ts-display-d3 text-shimmer">{s.title}</h1>
        <p class="section__lead ts-body-lg-regular measure">{s.lead}</p>
      </div>
      <ul class="info-grid">
        {s.packages.map((p, i) => (
          <li class="info-card">
            <Icon name={PKG[i] ?? "component"} class="info-card__icon" />
            <h2 class="info-card__title ts-title-t3">{p.name}</h2>
            <p class="info-card__detail ts-body-md-regular"><span class="info-card__label ts-label-sm">{s.forLabel}</span><br /><span class="info-card__answer">{p.forWhom}</span></p>
            <p class="info-card__detail ts-body-md-regular"><span class="info-card__label ts-label-sm">{s.resultLabel}</span><br /><span class="info-card__answer">{p.result}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="process-title" data-reveal>
    <div class="container stack">
      <div class="section__head">
        <h2 class="section__title ts-title-t1 text-shimmer" id="process-title">{s.processTitle}</h2>
        <p class="section__lead ts-body-lg-regular measure">{s.processLead}</p>
      </div>
      <ProcessFlow lang={lang} />
      <p class="ts-body-md-regular measure note">{s.note}</p>
      <div><Button size="lg" icon="mail" href={href(lang, "contact")} data-event="services_contact">{d.cta.button}</Button></div>
    </div>
  </section>
</Base>

<style>
  .note { color: var(--section-lead-color); }
</style>
