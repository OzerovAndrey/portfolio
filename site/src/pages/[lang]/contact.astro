---
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import { config, formatPhone, links } from "../../config";
import { staticLangPaths, t, type Locale } from "../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
const c = d.contact;
const { email, linkedin, telegram, phone } = config.contacts;
const direct = links([email, email && `mailto:${email}`, "mail"], ["LinkedIn", linkedin, "linkedin"], ["Telegram", telegram, "send"], [formatPhone(phone), phone && `tel:${phone}`, "phone"]);
---
<Base lang={lang} page="contact" title={d.meta.contactTitle} description={d.meta.contactDescription}>
  <section class="section">
    <div class="container contact">
      <div class="section__head">
        <h1 class="section__title ts-display-d3 text-shimmer">{c.title}</h1>
        <p class="section__lead ts-body-lg-regular measure">{c.lead}</p>
      </div>

      {config.formEndpoint ? (
        <form class="form" action={config.formEndpoint} method="POST" data-form data-sending={c.sending} data-success={c.success} data-error={c.error}>
          <div class="field">
            <label class="field__label ts-label-md" for="f-name">{c.name}</label>
            <input class="field__input ts-body-md-regular" id="f-name" name="name" autocomplete="name" required />
          </div>
          <div class="field">
            <label class="field__label ts-label-md" for="f-email">{c.email}</label>
            <input class="field__input ts-body-md-regular" id="f-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label class="field__label ts-label-md" for="f-company">{c.company} <span class="field__hint ts-body-sm-regular">· {c.companyHint}</span></label>
            <input class="field__input ts-body-md-regular" id="f-company" name="company" autocomplete="organization" />
          </div>
          <div class="field">
            <label class="field__label ts-label-md" for="f-need">{c.need}</label>
            <textarea class="field__input field__input--area ts-body-md-regular" id="f-need" name="message" rows="5" required aria-describedby="f-need-hint"></textarea>
            <p class="field__hint ts-body-sm-regular" id="f-need-hint">{c.needHint}</p>
          </div>
          <input type="hidden" name="_language" value={lang} />
          <div class="form__actions">
            <Button type="submit" size="lg" icon="send">{c.submit}</Button>
            <p class="form__status ts-body-md-regular" role="status" aria-live="polite"></p>
          </div>
        </form>
      ) : (
        <div class="brief">
          <h2 class="ts-title-t4">{c.includeTitle}</h2>
          <ol class="brief__list">{c.include.map((x, i) => <li class="brief__item ts-body-lg-regular"><span class="brief__n ts-label-md">0{i + 1}</span>{x}</li>)}</ol>
          {email && <div><Button size="lg" icon="mail" href={`mailto:${email}?subject=${encodeURIComponent(c.emailSubject)}`} data-event="contact_email">{c.emailCta}</Button></div>}
          {!direct.length && <p class="field__hint ts-body-md-regular">{c.noForm}</p>}
        </div>
      )}

      {direct.length > 0 && (
        <div class="direct">
          <h2 class="ts-title-t4">{c.direct}</h2>
          <ul class="direct__list">
            {direct.map((l) => <li><a class="direct__link ts-body-lg-regular" href={l.url} target={l.url.startsWith("http") ? "_blank" : undefined} rel={l.url.startsWith("http") ? "noopener" : undefined} data-event={`contact_${l.icon ?? "link"}`}>{l.icon && <Icon name={l.icon} class="direct__icon" />}<span>{l.label}</span><Icon name="arrowUpRight" class="direct__go" /></a></li>)}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  // Прогресивне покращення: без JS форма відправляється звичайним POST.
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>(".form__status")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    btn.disabled = true;
    status.className = "form__status ts-body-md-regular";
    status.textContent = form.dataset.sending ?? "";
    try {
      const r = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      if (!r.ok) throw new Error(String(r.status));
      form.reset();
      // Подія тільки після реальної відправки, не на клік (клік із помилкою валідації не рахуємо)
      (window as unknown as { umami?: { track: (e: string) => void } }).umami?.track("contact_sent");
      status.classList.add("is-success");
      status.textContent = form.dataset.success ?? "";
    } catch {
      status.classList.add("is-error");
      status.textContent = form.dataset.error ?? "";
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact { display: flex; flex-direction: column; gap: var(--section-text-block); }
  .contact .section__head { margin-bottom: 0; }
  .form { display: flex; flex-direction: column; gap: var(--contactForm-gap); max-width: 40rem; }
  .field { display: flex; flex-direction: column; gap: var(--input-wrapper-gap); }
  .field__label { color: var(--input-label-color-default); }
  .field__hint { color: var(--contactForm-hint-color); }
  .field__input {
    min-height: var(--input-size-lg); padding-inline: var(--input-paddingH-lg);
    background: var(--input-bg-default); color: var(--input-color-default);
    border: var(--input-borderWidth) solid var(--input-br-default); border-radius: var(--input-borderRadius);
  }
  .field__input:hover { border-color: var(--input-br-hover); }
  .field__input:focus-visible { border-color: var(--input-br-active); }
  .field__input--area { padding-block: var(--input-paddingH-lg); resize: vertical; }
  .form__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--contactForm-actions-gap); }
  .form__status { color: var(--contactForm-hint-color); }
  .form__status:global(.is-success) { color: var(--contactForm-success-color); }
  .form__status:global(.is-error) { color: var(--contactForm-error-color); }
  /* Без форми: ліворуч «що написати» + кнопка листа, праворуч великі рядки контактів */
  @media (min-width: 1024px) { .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--contactForm-columnGap); align-items: start; }
    .contact .section__head { grid-column: 1 / -1; } }
  .brief { display: flex; flex-direction: column; gap: var(--section-text-heading); }
  .brief__list { list-style: none; margin: 0; padding: 0; display: grid; border-top: var(--metric-borderWidth) solid var(--metric-br); }
  .brief__item { display: flex; gap: var(--space-gap-lg); align-items: baseline; padding-block: var(--space-padding-md); border-bottom: var(--metric-borderWidth) solid var(--metric-br); color: var(--section-title-color); }
  .brief__n { color: var(--metric-label-color); }
  .direct { display: flex; flex-direction: column; gap: var(--section-text-heading); }
  .direct__list { list-style: none; margin: 0; padding: 0; display: grid; border-top: var(--metric-borderWidth) solid var(--metric-br); }
  .direct__link { display: flex; align-items: center; gap: var(--space-gap-lg); padding-block: var(--space-padding-md);
    border-bottom: var(--metric-borderWidth) solid var(--metric-br); color: var(--section-title-color); text-decoration: none; }
  .direct__link:hover span { text-decoration: underline; text-underline-offset: var(--space-gap-xs); }
  .direct__link :global(.direct__icon) { --icon-size: var(--iconSize-md); color: var(--section-lead-color); }
  .direct__link :global(.direct__go) { --icon-size: var(--iconSize-sm); margin-left: auto; color: var(--section-lead-color); transition: transform var(--motion-duration-fast) var(--motion-easing-out); }
  @media (hover: hover) { .direct__link:hover :global(.direct__go) { transform: translate(var(--motion-nudge), calc(var(--motion-nudge) * -1)); } }
  @media (prefers-reduced-motion: reduce) { .direct__link :global(.direct__go) { transform: none !important; } }
</style>
