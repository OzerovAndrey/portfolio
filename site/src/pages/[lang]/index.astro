---
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Hero from "../../components/Hero.astro";
import ExploreSystem from "../../components/ExploreSystem.astro";
import AmbientShapes from "../../components/AmbientShapes.astro";
import Expertise from "../../components/Expertise.astro";
import { href, staticLangPaths, t, type Locale } from "../../i18n";

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Locale;
const d = t(lang);
---
<Base lang={lang} page="home" title={d.meta.homeTitle} description={d.meta.homeDescription}>
  <Hero lang={lang} />

  <!-- 02: другий шар — три відкриті ілюстровані колонки. Positioning, Signature Work, демо, How, Architecture, Cases, Audience з Home прибрано
       (компоненти й копі лишились: Approach, Cases, About). Головна інтерактивна сцена — тільки в Hero -->
  <ExploreSystem lang={lang} />

  <div class="home-atmosphere">
  <AmbientShapes />
  <Expertise lang={lang} compact />

  <section class="section section--alt" aria-labelledby="cta-title" data-reveal>
    <div class="container">
      <div class="cta">
        <div class="cta__text">
          <h2 class="cta__title ts-title-t2 text-shimmer" id="cta-title">{d.cta.title}</h2>
          <p class="cta__lead ts-body-lg-regular measure">{d.cta.lead}</p>
        </div>
        <Button size="lg" icon="mail" href={href(lang, "contact")} data-event="cta_contact">{d.cta.button}</Button>
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  .home-atmosphere { position: relative; isolation: isolate; overflow: clip; }
  .home-atmosphere :global(.container) { position: relative; z-index: 2; }
  /* Фінальний CTA: без рамки й плашки — великий заголовок, лід і основна кнопка (action) */
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--ctaBand-gap); }
  .cta__text { display: flex; flex-direction: column; gap: var(--section-text-heading); }
  .cta__title { color: var(--ctaBand-title-color); font-size: var(--ctaBand-title-fontSize); line-height: var(--ctaBand-title-lineHeight); letter-spacing: var(--ctaBand-title-letterSpacing); max-width: 18ch; text-wrap: balance; overflow-wrap: anywhere; }
  .cta__lead { color: var(--ctaBand-lead-color); overflow-wrap: anywhere; }

</style>
